#!/usr/bin/env bash
# gitsetu — One command. All identities. Every machine.
#
# A zero-dependency CLI tool for automated Git multi-identity
# and SSH key setup. Clone, run, done.
#
# Usage: ./gitsetu setup [--dry-run]
#        ./gitsetu status
#        ./gitsetu verify
#        ./gitsetu guard --install | --uninstall
#        ./gitsetu --help | --version
#
# https://github.com/bhaskarjha-dev/gitsetu
# MIT License — Bhaskar Jha

# --- CRLF self-healing for VirtualBox shared folders & Windows clones ---
# Every executable line in this trampoline ends in a comment so a literal CR
# remains harmless while Bash parses the un-normalized file.
_crlf_source="${BASH_SOURCE[0]:-$0}" #
_crlf_source="${_crlf_source//$'\r'/}" #
if [[ "$_crlf_source" != /* && ! "$_crlf_source" =~ ^[a-zA-Z]:/ ]]; then _crlf_source="$(pwd -W 2>/dev/null || pwd -P 2>/dev/null || pwd)/$_crlf_source"; fi  #
_crlf_hops=0 #
while [[ -L "$_crlf_source" && "$_crlf_hops" -lt 40 ]]; do  #
    _crlf_link_dir=$(cd -P -- "$(dirname "$_crlf_source")" 2>/dev/null && (pwd -W 2>/dev/null || pwd -P)) || exit 1  #
    _crlf_source=$(readlink "$_crlf_source") || exit 1  #
    if [[ "$_crlf_source" != /* && ! "$_crlf_source" =~ ^[a-zA-Z]:/ ]]; then _crlf_source="${_crlf_link_dir}/$_crlf_source"; fi  #
    _crlf_hops=$((_crlf_hops + 1))  #
done  #
[[ "$_crlf_hops" -lt 40 && -f "$_crlf_source" && ! -L "$_crlf_source" ]] || { printf '%s\n' "Error: unable to resolve the GitSetu entrypoint." >&2; exit 1; }  #
_crlf_orig_dir=$(cd -P -- "$(dirname "$_crlf_source")" 2>/dev/null && (pwd -W 2>/dev/null || pwd -P)) || exit 1  #
_crlf_temp_dir="$_crlf_orig_dir" #
_crlf_handoff_active=0 #
if [[ "${GITSETU_CRLF_DEPTH:-0}" != "1" ]]; then unset _GITSETU_CRLF_RUNTIME_DIR _GITSETU_CRLF_ORIGIN_DIR 2>/dev/null || true; fi #
if [[ "${GITSETU_CRLF_DEPTH:-0}" == "1" && -n "${_GITSETU_CRLF_RUNTIME_DIR:-}" && -n "${_GITSETU_CRLF_ORIGIN_DIR:-}" ]]; then #
    _crlf_handoff_runtime="${_GITSETU_CRLF_RUNTIME_DIR}" #
    _crlf_handoff_origin="${_GITSETU_CRLF_ORIGIN_DIR}" #
    [[ "$_crlf_handoff_runtime" != *$'\r'* && "$_crlf_handoff_runtime" != *$'\n'* && "$_crlf_handoff_runtime" != *$'\t'* ]] || { printf '%s\n' "Error: CRLF runtime handoff path is unsafe." >&2; exit 1; } #
    [[ "$_crlf_handoff_origin" != *$'\r'* && "$_crlf_handoff_origin" != *$'\n'* && "$_crlf_handoff_origin" != *$'\t'* ]] || { printf '%s\n' "Error: CRLF source handoff path is unsafe." >&2; exit 1; } #
    case "$_crlf_handoff_runtime" in /tmp/.gitsetu-runtime.*|/var/tmp/.gitsetu-runtime.*) ;; *) printf '%s\n' "Error: CRLF runtime handoff is not a trusted private path." >&2; exit 1 ;; esac #
    [[ -d "$_crlf_handoff_runtime" && ! -L "$_crlf_handoff_runtime" && -O "$_crlf_handoff_runtime" ]] || { printf '%s\n' "Error: CRLF runtime handoff directory is unsafe." >&2; exit 1; } #
    [[ -d "$_crlf_handoff_origin" && ! -L "$_crlf_handoff_origin" ]] || { printf '%s\n' "Error: CRLF source handoff directory is unsafe." >&2; exit 1; } #
    if [[ "$_crlf_handoff_origin" =~ ^[A-Za-z]:/ ]]; then _crlf_handoff_origin_canonical=$(cd -P -- "$_crlf_handoff_origin" 2>/dev/null && (pwd -W 2>/dev/null || pwd -P)) || exit 1; else _crlf_handoff_origin_canonical=$(cd -P -- "$_crlf_handoff_origin" 2>/dev/null && pwd -P) || exit 1; fi #
    [[ "$_crlf_handoff_origin" == "$_crlf_handoff_origin_canonical" ]] || { printf '%s\n' "Error: CRLF source handoff is not canonical." >&2; exit 1; } #
    case "$_crlf_source" in "$_crlf_handoff_runtime"/*) ;; *) printf '%s\n' "Error: CRLF child is outside the trusted runtime handoff." >&2; exit 1 ;; esac #
    _crlf_orig_dir="$_crlf_handoff_origin" #
    _crlf_temp_dir="$_crlf_handoff_runtime" #
    _crlf_handoff_active=1 #
fi #

# C-05: validate inherited numeric values before any arithmetic context. Values
# must already be canonical decimal strings; user-controlled text is never
# evaluated as an arithmetic expression.
_gitsetu_crlf_depth="${GITSETU_CRLF_DEPTH:-0}" #
if [[ -n "${GITSETU_CRLF_DEPTH:-}" ]]; then  #
    if [[ ! "$_gitsetu_crlf_depth" =~ ^(0|[1-9][0-9]*)$ ]]; then printf '%s\n' "Error: GITSETU_CRLF_DEPTH must be a canonical non-negative decimal integer." >&2; exit 1; fi  #
    if [[ "$_gitsetu_crlf_depth" != "0" && "$_gitsetu_crlf_depth" != "1" ]]; then printf '%s\n' "Error: CRLF self-healing recursion limit reached (depth=$_gitsetu_crlf_depth)." >&2; exit 1; fi  #
fi #

_gitsetu_lock_timeout="${GITSETU_LOCK_TIMEOUT:-}" #
if [[ -n "$_gitsetu_lock_timeout" ]]; then  #
    if [[ ! "$_gitsetu_lock_timeout" =~ ^[1-9][0-9]*$ ]]; then printf '%s\n' "Error: GITSETU_LOCK_TIMEOUT must be a canonical positive decimal integer." >&2; exit 1; fi  #
    if [[ "$_gitsetu_lock_timeout" == "0" || "${#_gitsetu_lock_timeout}" -gt 4 || ( "${#_gitsetu_lock_timeout}" -eq 4 && "$_gitsetu_lock_timeout" -gt 3600 ) ]]; then printf '%s\n' "Error: GITSETU_LOCK_TIMEOUT is outside the supported range (1-3600 seconds)." >&2; exit 1; fi  #
fi #

for _gitsetu_flag_name in GITSETU_PORT443_NEEDED GITSETU_TEST GITSETU_VERIFY_NETWORK GITSETU_ALLOW_SSH_HOST_KEY GITSETU_SSH_ACCEPT_NEW_HOST GITSETU_ALLOW_SSH_PORT443 GITSETU_DEFAULT_SIGN; do  #
    _gitsetu_flag_value="${!_gitsetu_flag_name:-0}"  #
    if [[ "$_gitsetu_flag_value" != "0" && "$_gitsetu_flag_value" != "1" ]]; then printf '%s\n' "Error: $_gitsetu_flag_name must be 0 or 1." >&2; exit 1; fi  #
done #

# Routing mutations are process state, never caller configuration. A consent
# flow may set the fallback later in-process; inherited values are discarded.
GITSETU_PORT443_NEEDED=0  #
GITSETU_PORT443_CONSENT=0  #
[[ "${GITSETU_ALLOW_SSH_PORT443:-0}" == "1" ]] && GITSETU_PORT443_CONSENT=1  #
export GITSETU_PORT443_NEEDED GITSETU_PORT443_CONSENT  #

# Inherited cleanup variables are never authoritative. The trampoline creates
# and removes one exclusive file in the trusted entrypoint directory itself.
unset GITSETU_CRLF_TMP GITSETU_CRLF_CLEAN GITSETU_ORIG_SCRIPT 2>/dev/null || true #

_crlf_probe="" #
read -r _crlf_probe < "$_crlf_source" 2>/dev/null || true #
if [[ "$_crlf_probe" == *$'\r'* ]]; then  #
    if [[ "$_gitsetu_crlf_depth" == "1" ]]; then printf '%s\n' "Error: CRLF normalization loop detected." >&2; exit 1; fi  #
    if ! command -v mktemp >/dev/null 2>&1; then printf '%s\n' "Error: secure mktemp is required for CRLF recovery." >&2; exit 1; fi  #
    _crlf_runtime_dir="" #
    _crlf_tmp=$(umask 077; mktemp "${_crlf_orig_dir}/.gitsetu_crlf.XXXXXX" 2>/dev/null || true) #
    if [[ -z "$_crlf_tmp" ]]; then #
        for _crlf_runtime_base in /tmp /var/tmp; do #
            [[ -d "$_crlf_runtime_base" && -w "$_crlf_runtime_base" && ! -L "$_crlf_runtime_base" ]] || continue #
            _crlf_runtime_candidate=$(umask 077; mktemp -d "${_crlf_runtime_base}/.gitsetu-runtime.XXXXXX" 2>/dev/null || true) #
            case "$_crlf_runtime_candidate" in "${_crlf_runtime_base}/.gitsetu-runtime."*) ;; *) _crlf_runtime_candidate=""; continue ;; esac #
            if [[ "$_crlf_runtime_candidate" == *$'\r'* || "$_crlf_runtime_candidate" == *$'\n'* || "$_crlf_runtime_candidate" == *$'\t'* ]]; then #
                rmdir "$_crlf_runtime_candidate" 2>/dev/null || true  #
                continue  #
            fi  #
            if [[ -d "$_crlf_runtime_candidate" && ! -L "$_crlf_runtime_candidate" && -O "$_crlf_runtime_candidate" ]]; then #
                if chmod 700 "$_crlf_runtime_candidate" 2>/dev/null; then _crlf_runtime_dir="$_crlf_runtime_candidate"; break; fi #
            fi #
            [[ ! -d "$_crlf_runtime_candidate" || ! -L "$_crlf_runtime_candidate" ]] && rmdir "$_crlf_runtime_candidate" 2>/dev/null || true #
        done #
        [[ -n "$_crlf_runtime_dir" ]] || { printf '%s\n' "Error: the GitSetu install directory is not writable and no trusted private runtime directory is available." >&2; exit 1; } #
        _crlf_temp_dir="$_crlf_runtime_dir" #
        _crlf_tmp=$(umask 077; mktemp "${_crlf_temp_dir}/.gitsetu_crlf.XXXXXX" 2>/dev/null || true) #
    fi #
    [[ -n "$_crlf_tmp" ]] || { printf '%s\n' "Error: failed to create a private CRLF recovery file." >&2; exit 1; } #
    case "$_crlf_tmp" in  #
        "$_crlf_temp_dir"/.gitsetu_crlf.*) ;;  #
        *) printf '%s\n' "Error: CRLF recovery did not receive a trusted temporary path." >&2; exit 1 ;;  #
    esac  #
    [[ "$_crlf_tmp" != *$'\r'* && "$_crlf_tmp" != *$'\n'* && "$_crlf_tmp" != *$'\t'* ]] || { printf '%s\n' "Error: CRLF recovery temporary path is unsafe." >&2; exit 1; }  #
    [[ -f "$_crlf_tmp" && ! -L "$_crlf_tmp" && -O "$_crlf_tmp" ]] || { printf '%s\n' "Error: CRLF recovery temporary file is unsafe." >&2; exit 1; }  #
    if [[ -n "$_crlf_runtime_dir" ]]; then  #
        export _GITSETU_CRLF_RUNTIME_DIR="$_crlf_runtime_dir" _GITSETU_CRLF_ORIGIN_DIR="$_crlf_orig_dir"  #
    else  #
        unset _GITSETU_CRLF_RUNTIME_DIR _GITSETU_CRLF_ORIGIN_DIR 2>/dev/null || true  #
    fi  #
    _crlf_parent_cleanup() { case "$_crlf_tmp" in "$_crlf_temp_dir"/.gitsetu_crlf.*) [[ -f "$_crlf_tmp" && ! -L "$_crlf_tmp" && -O "$_crlf_tmp" ]] && rm -f "$_crlf_tmp" 2>/dev/null || true ;; esac; [[ -n "${_crlf_runtime_dir:-}" ]] && { case "$_crlf_runtime_dir" in /tmp/.gitsetu-runtime.*|/var/tmp/.gitsetu-runtime.*) [[ -d "$_crlf_runtime_dir" && ! -L "$_crlf_runtime_dir" && -O "$_crlf_runtime_dir" ]] && rmdir "$_crlf_runtime_dir" 2>/dev/null || true ;; esac; }; }  #
    trap '_crlf_parent_cleanup' EXIT  #

    _crlf_normalized=0  #
    if command -v tr >/dev/null 2>&1 && tr -d '\r' < "$_crlf_source" > "$_crlf_tmp"; then _crlf_normalized=1; fi  #
    if [[ "$_crlf_normalized" -eq 0 ]] && command -v sed >/dev/null 2>&1 && sed -e 's/\r$//' < "$_crlf_source" > "$_crlf_tmp"; then _crlf_normalized=1; fi  #
    if [[ "$_crlf_normalized" -eq 0 ]] && command -v awk >/dev/null 2>&1 && awk '{ sub(/\r$/, ""); print }' "$_crlf_source" > "$_crlf_tmp"; then _crlf_normalized=1; fi  #
    if [[ "$_crlf_normalized" -eq 0 ]]; then while IFS= read -r _crlf_line || [[ -n "$_crlf_line" ]]; do printf '%s\n' "${_crlf_line%$'\r'}"; done < "$_crlf_source" > "$_crlf_tmp" && _crlf_normalized=1; fi  #
    if [[ "$_crlf_normalized" -ne 1 ]]; then _crlf_parent_cleanup; printf '%s\n' "Error: failed to normalize the CRLF-contaminated script." >&2; exit 1; fi  #
    chmod 700 "$_crlf_tmp" 2>/dev/null || true  #

    if [[ -n "${BASH:-}" ]]; then _crlf_bash="$BASH"; else _crlf_bash="bash"; fi  #
    GITSETU_CRLF_DEPTH=1 "$_crlf_bash" "$_crlf_tmp" "$@" &  #
    _crlf_child_pid=$!  #
    trap 'kill -TERM "$_crlf_child_pid" 2>/dev/null || true; wait "$_crlf_child_pid" 2>/dev/null || true; _crlf_parent_cleanup; exit 130' INT  #
    trap 'kill -TERM "$_crlf_child_pid" 2>/dev/null || true; wait "$_crlf_child_pid" 2>/dev/null || true; _crlf_parent_cleanup; exit 143' TERM  #
    _crlf_status=0  #
    wait "$_crlf_child_pid" || _crlf_status=$?  #
    _crlf_parent_cleanup  #
    trap - EXIT INT TERM  #
    exit "$_crlf_status"  #
fi #

set -euo pipefail

if [[ -z "${HOME:-}" ]]; then
    printf '%s\n' "Error: HOME must be set to a non-empty path." >&2
    exit 1
fi

# Only process-created temporary objects are registered for cleanup.
GITSETU_CLEANUP_FILES=()
GITSETU_CLEANUP_DIRS=()

gitsetu_early_cleanup() {
    local f d
    for f in ${GITSETU_CLEANUP_FILES[@]+"${GITSETU_CLEANUP_FILES[@]}"}; do
        [[ -n "$f" && "$f" != "/" && "$f" != "$HOME" ]] || continue
        rm -f "$f" 2>/dev/null || true
    done
    for d in ${GITSETU_CLEANUP_DIRS[@]+"${GITSETU_CLEANUP_DIRS[@]}"}; do
        [[ -n "$d" && "$d" != "/" && "$d" != "$HOME" && "$d" != "." ]] || continue
        rm -rf "$d" 2>/dev/null || true
    done
}
trap gitsetu_early_cleanup EXIT

# ------------------------------------------------------------------------------
# Resolve script directory (handles symlinks, $0 fallback, vboxsf CRLF re-exec)
# ------------------------------------------------------------------------------
resolve_script_dir() {
    local source="${BASH_SOURCE[0]:-$0}"
    source="${source//$'\r'/}"
    source="${source//\\//}"
    [[ -n "$source" ]] || return 1

    if [[ "$source" != /* ]] && [[ ! "$source" =~ ^[a-zA-Z]:/ ]]; then
        local base
        base=$(pwd -W 2>/dev/null || pwd -P 2>/dev/null || pwd) || return 1
        source="${base%/}/${source}"
    fi

    local hops=0
    while [[ -L "$source" && "$hops" -lt 40 ]]; do
        local link_dir
        link_dir=$(cd -P "$(dirname "$source")" 2>/dev/null && (pwd -W 2>/dev/null || pwd -P)) || return 1
        source=$(readlink "$source") || return 1
        if [[ "$source" != /* ]] && [[ ! "$source" =~ ^[a-zA-Z]:/ ]]; then
            source="${link_dir}/${source}"
        fi
        hops=$((hops + 1))
    done
    [[ "$hops" -lt 40 ]] || return 1

    local dir
    dir=$(cd -P "$(dirname "$source")" 2>/dev/null && (pwd -W 2>/dev/null || pwd -P)) || return 1
    printf '%s' "$dir"
}

if [[ "$_crlf_handoff_active" -eq 1 ]]; then
    GITSETU_SCRIPT_DIR="$_crlf_orig_dir"
else
    GITSETU_SCRIPT_DIR="$(resolve_script_dir || true)"
fi
GITSETU_SCRIPT_DIR="${GITSETU_SCRIPT_DIR//$'\r'/}"
# Never inherit an environment-selected module root or updater root.
GITSETU_DIR="$GITSETU_SCRIPT_DIR"

# ------------------------------------------------------------------------------
# Low-overhead prompt profile detection (no sourced modules required)
# ------------------------------------------------------------------------------
_gitsetu_lower() {
    local value="${1:-}"
    local output="" char i
    for (( i=0; i<${#value}; i++ )); do
        char="${value:i:1}"
        case "$char" in
            A) output="${output}a" ;; B) output="${output}b" ;; C) output="${output}c" ;; D) output="${output}d" ;;
            E) output="${output}e" ;; F) output="${output}f" ;; G) output="${output}g" ;; H) output="${output}h" ;;
            I) output="${output}i" ;; J) output="${output}j" ;; K) output="${output}k" ;; L) output="${output}l" ;;
            M) output="${output}m" ;; N) output="${output}n" ;; O) output="${output}o" ;; P) output="${output}p" ;;
            Q) output="${output}q" ;; R) output="${output}r" ;; S) output="${output}s" ;; T) output="${output}t" ;;
            U) output="${output}u" ;; V) output="${output}v" ;; W) output="${output}w" ;; X) output="${output}x" ;;
            Y) output="${output}y" ;; Z) output="${output}z" ;;
            *) output="${output}${char}" ;;
        esac
    done
    printf '%s' "$output"
}

_gitsetu_valid_encoded_field() {
    local field="${1:-}"
    [[ -z "$field" || "$field" =~ ^%[0-9A-F]{2}(%[0-9A-F]{2})*$ ]]
}

# Decode one canonical v2 field into _GITSETU_DECODED_FIELD without evaluating
# the encoded bytes as shell source.
_gitsetu_decode_registry_field() {
    local encoded="${1:-}"
    _GITSETU_DECODED_FIELD=""
    _gitsetu_valid_encoded_field "$encoded" || return 1
    [[ "$encoded" != *%00* ]] || return 1

    local decoded="" hex high low octal char i
    local high_value low_value
    for (( i=1; i<${#encoded}; i+=3 )); do
        hex="${encoded:i:2}"
        high="${hex:0:1}"
        low="${hex:1:1}"
        case "$high" in
            0) high_value=0 ;; 1) high_value=1 ;; 2) high_value=2 ;; 3) high_value=3 ;; 4) high_value=4 ;;
            5) high_value=5 ;; 6) high_value=6 ;; 7) high_value=7 ;; 8) high_value=8 ;; 9) high_value=9 ;;
            A) high_value=10 ;; B) high_value=11 ;; C) high_value=12 ;; D) high_value=13 ;; E) high_value=14 ;; F) high_value=15 ;;
            *) return 1 ;;
        esac
        case "$low" in
            0) low_value=0 ;; 1) low_value=1 ;; 2) low_value=2 ;; 3) low_value=3 ;; 4) low_value=4 ;;
            5) low_value=5 ;; 6) low_value=6 ;; 7) low_value=7 ;; 8) low_value=8 ;; 9) low_value=9 ;;
            A) low_value=10 ;; B) low_value=11 ;; C) low_value=12 ;; D) low_value=13 ;; E) low_value=14 ;; F) low_value=15 ;;
            *) return 1 ;;
        esac
        octal=$(( (high_value * 16) + low_value ))
        printf -v octal '%03o' "$octal"
        printf -v char '\\%s' "$octal"
        decoded="${decoded}${char}"
    done
    printf -v _GITSETU_DECODED_FIELD '%b' "$decoded"
}

_gitsetu_context_path() {
    local path="${1:-}"
    [[ -n "$path" ]] || return 1
    if [[ "$path" == "~" ]]; then
        path="$HOME"
    elif [[ "$path" == "~/"* ]]; then
        path="${HOME}/${path:2}"
    fi
    path="${path//\\//}"
    local drive rest
    if [[ "$path" =~ ^/([a-zA-Z])/(.*)$ ]]; then
        drive="${BASH_REMATCH[1]}"
        rest="${BASH_REMATCH[2]}"
        drive=$(printf '%s' "$drive" | tr '[:lower:]' '[:upper:]')
        path="${drive}:/${rest}"
    elif [[ "$path" =~ ^([a-zA-Z]):/(.*)$ ]]; then
        drive="${BASH_REMATCH[1]}"
        rest="${BASH_REMATCH[2]}"
        drive=$(printf '%s' "$drive" | tr '[:lower:]' '[:upper:]')
        path="${drive}:/${rest}"
    fi
    while [[ "${#path}" -gt 1 && "$path" == */ ]]; do path="${path%/}"; done
    printf '%s' "$path"
}

_gitsetu_case_insensitive_context() {
    case "${GITSETU_OS:-${OSTYPE:-}}" in
        gitbash|macos|msys*|mingw*|cygwin*|darwin*) return 0 ;;
    esac
    local u
    u=$(uname -s 2>/dev/null || true)
    case "$u" in MSYS*|MINGW*|CYGWIN*|Darwin*) return 0 ;; esac
    return 1
}

_gitsetu_prompt_valid_path() {
    local path="${1:-}"
    [[ -n "$path" ]] || return 1
    [[ "$path" == /* || "$path" =~ ^[A-Za-z]:/ ]] || return 1
    case "$path" in *\\*) return 1 ;; esac
    [[ "$path" != *$'\r'* && "$path" != *$'\n'* && "$path" != *$'\t'* ]] || return 1
    [[ "$path" != *'//'* && "$path" != '/../'* && "$path" != '../'* && "$path" != *'/./'* ]] || return 1
    [[ "$path" != *'/..' && "$path" != '/.' ]] || return 1
    return 0
}

_gitsetu_prompt_valid_provider() {
    local provider="${1:-}"
    local rest part
    [[ "$provider" == *.* && "$provider" != *..* && "$provider" != *[[:space:]]* ]] || return 1
    case "$provider" in *\\*) return 1 ;; esac
    [[ "$provider" != *:* && "$provider" != */* ]] || return 1
    rest="$provider"
    while :; do
        if [[ "$rest" == *.* ]]; then
            part="${rest%%.*}"
            rest="${rest#*.}"
        else
            part="$rest"
            rest=""
        fi
        [[ "$part" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || return 1
        [[ -n "$rest" ]] || break
    done
}

_gitsetu_prompt_valid_user() {
    local user="${1:-}"
    [[ -z "$user" ]] && return 0
    [[ "$user" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ && "$user" != *. && "$user" != *- && "$user" != *..* ]]
}

_gitsetu_prompt_valid_email() {
    local email="${1:-}"
    local local_part domain
    [[ -n "$email" && "$email" != *[[:cntrl:]]* && "$email" != *[[:space:]]* ]] || return 1
    [[ "$email" == *@* && "$email" != *@*@* ]] || return 1
    local_part="${email%%@*}"
    domain="${email#*@}"
    [[ -n "$local_part" && "$domain" == *.* && "$domain" != .* && "$domain" != *. && "$domain" != *..* ]] || return 1
    [[ "${domain##*.}" =~ ^[A-Za-z][A-Za-z0-9-]*$ ]]
}

_gitsetu_prompt_profile_identity_valid_impl() {
    local xdg_config="${1:-}"
    local label="${2:-}"
    local config_file="$xdg_config/gitsetu/profiles/${label}.gitconfig"
    local name email
    [[ -f "$config_file" && ! -L "$config_file" ]] || return 1
    [[ "$(stat -c '%s' "$config_file" 2>/dev/null || stat -f '%z' "$config_file" 2>/dev/null || printf '0')" != "0" ]] || return 1
    command -v git >/dev/null 2>&1 || return 1
    name=$(git config -f "$config_file" --get user.name 2>/dev/null) || return 1
    email=$(git config -f "$config_file" --get user.email 2>/dev/null) || return 1
    [[ -n "$name" && "$name" != *[[:cntrl:]]* && "$name" != " "* && "$name" != *" " && "$name" != *$'\t'* ]] || return 1
    _gitsetu_prompt_valid_email "$email"
}

_gitsetu_prompt_profile_identity_valid() {
    _gitsetu_prompt_profile_identity_valid_impl "$@" || {
        GITSETU_PROMPT_STATE="invalid"
        return 1
    }
}

cmd_prompt() {
    GITSETU_PROMPT_STATE="unmanaged"
    GITSETU_PROMPT_PROFILE=""
    local home="${HOME:-}"
    local xdg_config="${XDG_CONFIG_HOME:-$home/.config}"
    [[ -n "$home" ]] || return 0
    local conf_file="$xdg_config/gitsetu/profiles.conf"
    local current_pwd profile_dir check_pwd check_dir
    local raw_line encoded_label encoded_dir encoded_provider encoded_sign encoded_key encoded_user extra
    local label directory provider sign_commits key_path provider_user
    local matched_profile="" max_len=0 dir_len line_number=0 header_seen=0
    local case_insensitive=0 seen_labels=""

    case "$xdg_config" in
        /*|[a-zA-Z]:/*) ;;
        *) return 0 ;;
    esac
    [[ -f "$conf_file" && ! -L "$conf_file" ]] || return 0

    local windows_context=0
    case "${GITSETU_OS:-}:${OSTYPE:-}" in
        gitbash:*|msys:*|mingw:*|cygwin:*|*:cygwin*|*:msys*|*:mingw:*|*:CYGWIN*|*:MSYS*|*:MINGW*) windows_context=1 ;;
    esac
    if [[ "$windows_context" -eq 1 ]] && command -v pwd >/dev/null 2>&1; then
        current_pwd=$(pwd -W 2>/dev/null || pwd -P 2>/dev/null || printf '%s' "$PWD")
    elif [[ "$HOME" =~ ^[a-zA-Z]:/ ]] && command -v pwd >/dev/null 2>&1; then
        current_pwd=$(pwd -W 2>/dev/null || pwd -P 2>/dev/null || printf '%s' "$PWD")
    else
        current_pwd=$(pwd -P 2>/dev/null || printf '%s' "$PWD")
    fi
    current_pwd=$(_gitsetu_context_path "$current_pwd") || return 0
    if _gitsetu_case_insensitive_context; then
        case_insensitive=1
        check_pwd=$(_gitsetu_lower "$current_pwd")
    else
        check_pwd="$current_pwd"
    fi

    while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
        line_number=$((line_number + 1))
        if [[ "$line_number" -eq 1 ]]; then
            [[ "$raw_line" == "# gitsetu-registry-v2" ]] || return 0
            header_seen=1
            continue
        fi
        [[ "$header_seen" -eq 1 && -n "$raw_line" ]] || return 0
        [[ "${#raw_line}" -le 131072 ]] || return 0

        IFS=: read -r encoded_label encoded_dir encoded_provider encoded_sign encoded_key encoded_user extra <<< "$raw_line"
        [[ -z "$extra" ]] || return 0
        _gitsetu_valid_encoded_field "$encoded_label" || return 0
        _gitsetu_valid_encoded_field "$encoded_dir" || return 0
        _gitsetu_valid_encoded_field "$encoded_provider" || return 0
        _gitsetu_valid_encoded_field "$encoded_sign" || return 0
        _gitsetu_valid_encoded_field "$encoded_key" || return 0
        _gitsetu_valid_encoded_field "$encoded_user" || return 0

        _gitsetu_decode_registry_field "$encoded_label" || return 0
        label="$_GITSETU_DECODED_FIELD"
        _gitsetu_decode_registry_field "$encoded_dir" || return 0
        directory="$_GITSETU_DECODED_FIELD"
        _gitsetu_decode_registry_field "$encoded_provider" || return 0
        provider="$_GITSETU_DECODED_FIELD"
        _gitsetu_decode_registry_field "$encoded_sign" || return 0
        sign_commits="$_GITSETU_DECODED_FIELD"
        _gitsetu_decode_registry_field "$encoded_key" || return 0
        key_path="$_GITSETU_DECODED_FIELD"
        _gitsetu_decode_registry_field "$encoded_user" || return 0
        provider_user="$_GITSETU_DECODED_FIELD"

        [[ "$label" =~ ^[a-z][a-z0-9-]{0,19}$ && "$label" != *- ]] || return 0
        [[ "$sign_commits" == "0" || "$sign_commits" == "1" ]] || return 0
        _gitsetu_prompt_valid_provider "$provider" || return 0
        _gitsetu_prompt_valid_user "$provider_user" || return 0
        [[ -n "$key_path" ]] || return 0
        _gitsetu_prompt_valid_path "$key_path" || return 0
        if [[ "$label" == "global" ]]; then
            [[ -z "$directory" ]] || return 0
        else
            _gitsetu_prompt_valid_path "$directory" || return 0
            [[ "$directory" != "/" && ! "$directory" =~ ^[A-Za-z]:/$ ]] || return 0
        fi
        _gitsetu_prompt_profile_identity_valid "$xdg_config" "$label" || return 0
        if [[ -z "$seen_labels" && "$label" != "global" ]]; then
            return 0
        fi
        case $'\n'"$seen_labels"$'\n' in
            *$'\n'"$label"$'\n'*) return 0 ;;
        esac
        seen_labels="${seen_labels}${label}"$'\n'

        [[ -n "$directory" ]] || continue
        profile_dir=$(_gitsetu_context_path "$directory") || return 0
        check_dir="$profile_dir"
        [[ "$case_insensitive" -eq 0 ]] || check_dir=$(_gitsetu_lower "$check_dir")
        if [[ "$check_pwd/" == "$check_dir/"* || "$check_pwd" == "$check_dir" ]]; then
            dir_len=${#profile_dir}
            if [[ "$dir_len" -gt "$max_len" ]]; then
                max_len=$dir_len
                matched_profile="$label"
                GITSETU_PROMPT_PROFILE="$label"
            fi
        fi
    done < "$conf_file"

    [[ "$header_seen" -eq 1 ]] || return 0
    if [[ -n "$matched_profile" ]]; then
        GITSETU_PROMPT_STATE="matched"
        printf '%s\n' "$matched_profile"
    fi
    return 0
}

# Prompt is intentionally a source-free fast path for PS1 use.
if [[ "${1:-}" == "prompt" ]]; then
    shift
    if [[ $# -ne 0 ]]; then
        printf '%s\n' "Error: prompt does not accept arguments." >&2
        exit 1
    fi
    cmd_prompt
    exit $?
fi

