# ------------------------------------------------------------------------------
# cmd_status — Show current identity configuration
# ------------------------------------------------------------------------------
cmd_status() {
    detect_os
    if ! load_profiles; then
        print_error "The profile registry is invalid or uses an unsupported format."
        return 1
    fi

    print_header

    local cwd current_name current_email current_ssh
    local active_context="" active_label="global (unmanaged fallback)" active_marker="  "
    local prompt_state="unmanaged" inside_repo=0

    cwd=$(pwd -P 2>/dev/null || printf '%s' "$PWD")
    cwd=$(_gitsetu_context_path "$cwd" 2>/dev/null || printf '%s' "$cwd")
    cmd_prompt >/dev/null
    prompt_state="${GITSETU_PROMPT_STATE:-unmanaged}"
    active_context="${GITSETU_PROMPT_PROFILE:-}"
    if [[ -n "$active_context" ]]; then
        active_label="$active_context"
        active_marker="${GREEN}${SYM_CHECK} ${RESET}"
    fi

    print_section "Current Directory"
    printf >&2 '  %s\n' "$(escape_terminal_text "$cwd")"
    printf >&2 '  Directory context: %s\n\n' "$(escape_terminal_text "$active_label")"

    if command -v git >/dev/null 2>&1; then
        current_name=$(git config user.name 2>/dev/null || true)
        current_email=$(git config user.email 2>/dev/null || true)
        current_ssh=$(git config core.sshCommand 2>/dev/null || true)
        git rev-parse --is-inside-work-tree >/dev/null 2>&1 && inside_repo=1
    else
        current_name=""
        current_email=""
        current_ssh=""
    fi
    [[ -n "$current_name" ]] || current_name="(not set)"
    [[ -n "$current_email" ]] || current_email="(not set)"
    [[ -n "$current_ssh" ]] || current_ssh="(default)"

    printf >&2 '  %b┌─ Active Identity ─────────────────────────────┐%b\n' "$BOLD" "$RESET"
    printf >&2 '  %b│%b  Name:  %b%s%b\n' "$DIM" "$RESET" "$CYAN" "$(escape_terminal_text "$current_name")" "$RESET"
    printf >&2 '  %b│%b  Email: %b%s%b\n' "$DIM" "$RESET" "$CYAN" "$(escape_terminal_text "$current_email")" "$RESET"
    if [[ "$inside_repo" -eq 1 ]]; then
        printf >&2 '  %b│%b  SSH:   %b%s%b\n' "$DIM" "$RESET" "$GREEN" "$(escape_terminal_text "$current_ssh")" "$RESET"
    fi

    local local_hooks=""
    if [[ "$inside_repo" -eq 1 ]]; then
        local_hooks=$(git config --local core.hooksPath 2>/dev/null || true)
        if [[ -n "$local_hooks" ]]; then
            printf >&2 '  %b│%b  %b[!] Local core.hooksPath override:%b\n' "$DIM" "$RESET" "$RED" "$RESET"
            printf >&2 '  %b│%b      %s\n' "$DIM" "$RESET" "$(escape_terminal_text "$local_hooks")"
        fi
    fi
    printf >&2 '  %b└───────────────────────────────────────────────┘%b\n\n' "$DIM" "$RESET"

    print_section "Guard Policy"
    if [[ "$inside_repo" -eq 1 && -n "$active_context" ]]; then
        printf >&2 '  Managed repository (%s): fail-closed when expected identity is unresolved or differs.\n' \
            "$(escape_terminal_text "$active_context")"
    elif [[ "$inside_repo" -eq 1 && "$prompt_state" == "invalid" ]]; then
        printf >&2 '  Managed state indeterminate: fail-closed until the profile registry/configuration is repaired.\n'
    elif [[ "$inside_repo" -eq 1 ]]; then
        printf >&2 '  Unmanaged repository: fail-open; GitSetu does not enforce an identity here.\n'
    else
        printf >&2 '  Unmanaged directory: fail-open; guard policy applies only inside Git repositories.\n'
    fi
    local global_hooks
    global_hooks=$(git config --global core.hooksPath 2>/dev/null || true)
    if [[ -f "$GITSETU_HOOKS_DIR/pre-commit" ]]; then
        printf >&2 '  Guard hook: installed at %s\n' "$(escape_terminal_text "$GITSETU_HOOKS_DIR/pre-commit")"
    else
        printf >&2 '  Guard hook: not installed. Explicit opt-out: gitsetu guard --uninstall\n'
    fi
    if [[ -n "$local_hooks" ]]; then
        printf >&2 '  %bLocal hook policy: this repository override can bypass the global guard.%b\n' "$YELLOW" "$RESET"
    elif [[ -n "$global_hooks" && "$global_hooks" != "$GITSETU_HOOKS_DIR" ]]; then
        printf >&2 '  %bGlobal hook policy: core.hooksPath points outside GitSetu (%s).%b\n' \
            "$YELLOW" "$(escape_terminal_text "$global_hooks")" "$RESET"
    fi
    printf >&2 '\n'

    if [[ "${PROFILE_COUNT:-0}" -gt 0 ]]; then
        print_section "Configured Profiles"
        local i label profile_email provider dir_disp safe_label safe_email safe_provider safe_dir
        for (( i=0; i<PROFILE_COUNT; i++ )); do
            label="${PROFILE_LABELS[$i]:-}"
            profile_email=$(git config -f "$GITSETU_PROFILES_DIR/${label}.gitconfig" user.email 2>/dev/null || true)
            [[ -n "$profile_email" ]] || profile_email="(unresolved)"
            provider="${PROFILE_PROVIDERS[$i]:-github.com}"
            dir_disp="${PROFILE_DIRS[$i]:-[Manual / global]}"

            safe_label=$(escape_terminal_text "$label")
            safe_email=$(escape_terminal_text "$profile_email")
            safe_provider=$(escape_terminal_text "$provider")
            safe_dir=$(escape_terminal_text "$dir_disp")
            local marker="  "
            [[ "$label" == "$active_context" ]] && marker="$active_marker"

            printf >&2 '  %s%b%s%b\n' "$marker" "$BOLD" "$safe_label" "$RESET"
            printf >&2 '    %b├─%b %-9s %s\n' "$DIM" "$RESET" "Email:" "$safe_email"
            printf >&2 '    %b├─%b %-9s %s\n' "$DIM" "$RESET" "Provider:" "$safe_provider"
            printf >&2 '    %b└─%b %-9s %s\n\n' "$DIM" "$RESET" "Path:" "$safe_dir"
        done
    else
        print_info "No complete profiles configured. Run 'gitsetu setup' to get started."
    fi

    print_section "Environment"
    printf >&2 '  OS:       %s\n' "$(escape_terminal_text "$GITSETU_OS")"
    printf >&2 '  Bash:     %s\n' "$(escape_terminal_text "${BASH_VERSION:-unknown}")"
    printf >&2 '  Git:      %s\n' "$(escape_terminal_text "$(git --version 2>/dev/null | head -n1 || printf 'unavailable')")"
    printf >&2 '  Config:   %s\n' "$(escape_terminal_text "$GITSETU_CONFIG_DIR")"
    printf >&2 '\n'
}

# ------------------------------------------------------------------------------
# cmd_update — Verify an explicitly selected local development checkout
# ------------------------------------------------------------------------------
GITSETU_DEVELOPMENT_BRANCH="feature/v1.1.0-onboarding-overhaul"

_gitsetu_update_git() {
    (
        unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
            GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_INDEX_FILE GIT_NAMESPACE
        command git -C "$GITSETU_DIR" "$@"
    )
}

cmd_update() {
    local mode="${1:-}"
    detect_os
    print_header

    if [[ "$mode" != "--development" && "$mode" != "--dev" ]]; then
        print_error "Production update is disabled while v1.1.0 is in development."
        print_info "For a clean local development checkout, run: gitsetu update --development"
        print_info "No remote branch is fetched or used as a trust root."
        return 1
    fi
    if [[ ! -d "$GITSETU_DIR/.git" ]]; then
        print_error "Development verification requires the canonical GitSetu checkout."
        return 1
    fi

    local status
    status=$(_gitsetu_update_git status --porcelain=v1 --untracked-files=all 2>/dev/null) || {
        print_error "Unable to verify the development checkout status."
        return 1
    }
    if [[ -n "$status" ]]; then
        print_error "Development checkout is dirty; no update or reset was attempted."
        return 1
    fi

    local branch
    branch=$(_gitsetu_update_git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
    if [[ "$branch" != "$GITSETU_DEVELOPMENT_BRANCH" ]]; then
        print_error "Development branch drift detected (expected '$GITSETU_DEVELOPMENT_BRANCH', found '${branch:-detached}')."
        return 1
    fi

    local commit
    commit=$(_gitsetu_update_git rev-parse --verify 'HEAD^{commit}' 2>/dev/null) || {
        print_error "Development checkout HEAD could not be verified."
        return 1
    }
    [[ "$commit" =~ ^[0-9a-fA-F]{40,64}$ ]] || {
        print_error "Development checkout HEAD is not a verified commit object."
        return 1
    }

    local module
    for module in gitsetu lib/core.sh lib/platform.sh lib/ui.sh lib/validate.sh lib/backup.sh \
        lib/ssh.sh lib/gitconfig.sh lib/guard.sh lib/doctor.sh lib/verify.sh lib/teardown.sh \
        lib/discovery.sh lib/setup.sh lib/keychain.sh; do
        if ! _gitsetu_update_git ls-files --error-unmatch -- "$module" >/dev/null 2>&1 || \
           [[ ! -f "$GITSETU_DIR/$module" || -L "$GITSETU_DIR/$module" ]]; then
            print_error "Development verification failed: required tracked file is missing or unsafe: $module"
            return 1
        fi
    done

    print_success "Development checkout verified at $commit."
    print_info "No fetch, branch reset, or mutable remote update was performed."
    return 0
}

# ------------------------------------------------------------------------------
# cmd_verify — Run all verification checks
# ------------------------------------------------------------------------------
cmd_verify() {
    detect_os
    print_header

    # Load profiles from registry
    if [[ ! -f "$GITSETU_PROFILES_CONF" ]]; then
        print_error "No profiles configured. Run 'gitsetu setup' first."
        return 1
    fi

    # Read profiles from the strict v2 registry.
    if ! load_profiles; then
        print_error "The profile registry is invalid or uses an unsupported format."
        return 1
    fi

    if [[ "$PROFILE_COUNT" -eq 0 ]]; then
        print_error "No profiles found in registry. Run 'gitsetu setup' first."
        return 1
    fi

    verify_all
}

# ------------------------------------------------------------------------------
# cmd_teardown — Remove all gitsetu configurations
# ------------------------------------------------------------------------------
cmd_teardown() {
    detect_os
    print_header

    if [[ "$GITSETU_DRY_RUN" -eq 1 ]]; then
        print_info "DRY RUN MODE — no files will be written/deleted"
        printf >&2 '\n'
    fi

    local force="${1:-0}"
    local deep="${2:-0}"

    if [[ "$force" -eq 0 ]] && [[ "$GITSETU_DRY_RUN" -eq 0 ]]; then
        print_warning "This will remove all GitSetu configurations:"
        printf >&2 "  - Remove managed blocks from ~/.gitconfig\n"
        printf >&2 "  - Remove Include directive from ~/.ssh/config\n"
        printf >&2 "  - Uninstall the commit guard hook\n"
        printf >&2 "  - Delete the ~/.config/gitsetu directory\n"
        if [[ "$deep" -eq 1 ]]; then
            printf >&2 "  - STRIP local identity overrides from all mapped repositories\n"
        fi
        printf >&2 "\n"
        if ! confirm "Are you sure you want to proceed?" "n"; then
            print_info "Teardown cancelled."
            return 0
        fi
    fi

    acquire_lock || return 1
    local teardown_status=0
    teardown_all "$deep" || teardown_status=$?
    if [[ "$teardown_status" -ne 0 ]]; then
        print_error "Teardown failed; no successful completion is being reported."
        release_lock || print_error "Failed to release the teardown lock."
        return 1
    fi
    if ! release_lock; then
        print_error "Teardown completed but the lock could not be released."
        return 1
    fi
    return 0
}

# ------------------------------------------------------------------------------
# cmd_setup — Interactive Blueprint Dashboard / Headless setup
# ------------------------------------------------------------------------------
cmd_setup() {
    local auto_mode="${1:-0}"
    detect_os
    print_header

    if [[ "$GITSETU_DRY_RUN" -eq 1 ]]; then
        print_info "DRY RUN MODE — no files will be written"
        printf >&2 '\n'
    fi

    # --- Preflight ---
    print_section "Preflight Checks"
    printf >&2 '  OS detected: %b%s%b\n' "$BOLD" "$GITSETU_OS" "$RESET"

    if ! check_prerequisites; then
        return 1
    fi
    print_success "All prerequisites met"

    # Check for shared folder
    if is_shared_mount "$HOME" 2>/dev/null; then
        print_warning "Home directory appears to be on a shared folder."
        print_info "SSH keys will be stored on the native filesystem at ~/.ssh"
    fi

    # Fast-path for autonomous zero-prompt discovery mode
    if [[ "$auto_mode" -eq 1 ]]; then
        export GITSETU_AUTO_MODE=1
        acquire_lock || return 1
        auto_setup_runner
        local auto_res=$?
        release_lock
        return "$auto_res"
    fi

    # Check if TTY
    if [[ ! -t 1 ]]; then
        print_error "Interactive setup requires an interactive terminal (TTY)."
        print_error "For automated non-interactive setup, run: gitsetu setup --auto"
        print_error "For headless profile scripting, use: gitsetu profile add <label> --email=..."
        return 1
    fi

    # Launch the interactive menu
    interactive_setup_wizard
}

# ------------------------------------------------------------------------------
# Runtime SSH-key validation and shell quoting
# ------------------------------------------------------------------------------
_gitsetu_shell_quote() {
    local value="${1:-}"
    value="${value//\'/\'\\\'\'}"
    printf "'%s'" "$value"
}

_gitsetu_runtime_key_valid() {
    local key_path="${1:-}"
    local mode owner current_user fs_type
    [[ -n "$key_path" && ! "$key_path" =~ [[:cntrl:]] ]] || return 1
    case "$key_path" in
        /*|[A-Za-z]:/*) ;;
        *) return 1 ;;
    esac
    [[ -f "$key_path" && ! -L "$key_path" && -O "$key_path" && \
       -f "${key_path}.pub" && ! -L "${key_path}.pub" && -O "${key_path}.pub" ]] || return 1
    case "$key_path" in
        *\\*|*//*|*/../*|*/./*) return 1 ;;
    esac
    if declare -f _ssh_assert_no_symlink_components >/dev/null 2>&1; then
        _ssh_assert_no_symlink_components "$(dirname "$key_path")" || return 1
    fi
    if declare -f _ssh_assert_private_directory >/dev/null 2>&1; then
        _ssh_assert_private_directory "$(dirname "$key_path")" || return 1
    fi
    mode=$(stat -c '%a' "$key_path" 2>/dev/null || stat -f '%Lp' "$key_path" 2>/dev/null || true)
    if [[ "$mode" != "600" ]]; then
        fs_type=$(df -PT "$key_path" 2>/dev/null | awk 'NR == 2 { print $2 }' | tr '[:upper:]' '[:lower:]')
        case "${GITSETU_OS:-}:${OSTYPE:-}:$fs_type" in
            gitbash:*:*ntfs|gitbash:*:*msfs|msys:*:*ntfs|cygwin:*:*ntfs|msys:*:*msfs|cygwin:*:*msfs) ;;
            *) return 1 ;;
        esac
    fi
    if command -v stat >/dev/null 2>&1 && command -v id >/dev/null 2>&1; then
        owner=$(stat -c '%U' "$key_path" 2>/dev/null || stat -f '%Su' "$key_path" 2>/dev/null || true)
        current_user=$(id -un 2>/dev/null || true)
        [[ -z "$owner" || -z "$current_user" || "$owner" == "$current_user" ]] || return 1
    fi
    return 0
}

# ------------------------------------------------------------------------------
# cmd_run — Execute a command under a specific profile identity
# ------------------------------------------------------------------------------
cmd_run() {
    detect_os

    local profile="${1:-}"
    if [[ $# -lt 2 || -z "$profile" ]]; then
        print_error "Usage: gitsetu run <profile> -- <command>"
        return 1
    fi
    shift
    if [[ "${1:-}" != "--" ]]; then
        print_error "The command must be separated from gitsetu arguments with '--'."
        return 1
    fi
    shift
    if [[ $# -eq 0 ]]; then
        print_error "No command provided. Usage: gitsetu run <profile> -- <command>"
        return 1
    fi

    profile=$(_gitsetu_lower "$profile")
    if ! validate_label "$profile"; then
        print_error "Invalid profile label: '$profile'."
        return 1
    fi
    if [[ ! -f "$GITSETU_PROFILES_CONF" ]]; then
        print_error "No profiles configured. Run 'gitsetu setup' first."
        return 1
    fi

    if ! load_profiles; then
        print_error "The profile registry is invalid or uses an unsupported format."
        return 1
    fi
    local found=0 found_key_path="" i
    for (( i=0; i<PROFILE_COUNT; i++ )); do
        if [[ "${PROFILE_LABELS[$i]:-}" == "$profile" ]]; then
            found=1
            found_key_path="${PROFILE_KEYS[$i]-}"
            break
        fi
    done

    if [[ "$found" -eq 0 ]]; then
        print_error "Profile '$profile' not found in registry."
        return 1
    fi

    local config_file="$GITSETU_PROFILES_DIR/${profile}.gitconfig"
    if [[ -L "$config_file" || ! -f "$config_file" ]]; then
        print_error "Profile config is missing or unsafe: $config_file"
        return 1
    fi

    local name email
    name=$(git config -f "$config_file" user.name 2>/dev/null || true)
    email=$(git config -f "$config_file" user.email 2>/dev/null || true)
    if [[ -z "$name" || -z "$email" ]] || ! validate_email "$email"; then
        print_error "Profile '$profile' has no complete, valid identity."
        return 1
    fi

    if [[ -z "$found_key_path" ]] || ! _gitsetu_runtime_key_valid "$found_key_path"; then
        print_error "Profile '$profile' has a missing, unsafe, or non-canonical SSH key path."
        return 1
    fi
    local quoted_key
    quoted_key=$(_gitsetu_shell_quote "$found_key_path")

    export GIT_AUTHOR_NAME="$name"
    export GIT_AUTHOR_EMAIL="$email"
    export GIT_COMMITTER_NAME="$name"
    export GIT_COMMITTER_EMAIL="$email"
    export GIT_SSH_COMMAND="ssh -i ${quoted_key}"

    gitsetu_global_cleanup
    exec "$@"
}

# ------------------------------------------------------------------------------
# cmd_remove — Surgically remove a single profile
# ------------------------------------------------------------------------------
cmd_remove() {
    detect_os

    local profile="${1:-}"
    local force_flag="${2:-}"
    if [[ $# -gt 2 || -z "$profile" ]]; then
        print_error "Usage: gitsetu remove <profile> [--force|-y]"
        return 1
    fi
    if [[ -n "$force_flag" && "$force_flag" != "--force" && "$force_flag" != "-y" ]]; then
        print_error "Unknown remove option: $force_flag"
        return 1
    fi

    profile=$(_gitsetu_lower "$profile")
    if ! validate_label "$profile"; then
        print_error "Invalid profile label: '$profile'."
        return 1
    fi
    if [[ ! -f "$GITSETU_PROFILES_CONF" ]]; then
        print_error "No profiles configured."
        return 1
    fi

    if ! load_profiles; then
        print_error "The profile registry is invalid or uses an unsupported format."
        return 1
    fi
    local found=0 found_index=-1 found_key_path="" i
    for (( i=0; i<PROFILE_COUNT; i++ )); do
        if [[ "${PROFILE_LABELS[$i]:-}" == "$profile" ]]; then
            found=1
            found_index=$i
            found_key_path="${PROFILE_KEYS[$i]-}"
            break
        fi
    done
    if [[ "$found" -eq 0 ]]; then
        print_error "Profile '$profile' not found."
        return 1
    fi
    if [[ "$found_index" -eq 0 ]]; then
        print_error "The global/default profile cannot be removed."
        return 1
    fi

    if [[ -z "$force_flag" ]]; then
        if ! confirm "Are you sure you want to completely remove profile '$profile'?" "n"; then
            print_info "Cancelled."
            return 0
        fi
    fi

    acquire_lock || return 1
    print_step "Removing profile '$profile'..."

    remove_profile_at_index "$found_index" || {
        print_error "Unable to remove profile from the in-memory blueprint."
        release_lock || true
        return 1
    }

    local failed=0
    # The v2 writer compiles profile configs and atomically publishes the encoded
    # registry. It is the only supported persistence path.
    write_profiles_conf || failed=1
    if [[ "$failed" -eq 0 ]]; then
        write_global_gitconfig || failed=1
        write_ssh_config || failed=1
    fi
    release_lock || failed=1
    [[ "$failed" -eq 0 ]] || return 1

    print_success "Profile '$profile' successfully removed."

    local key_file="$found_key_path"
    if [[ -f "$key_file" && ! -L "$key_file" ]]; then
        printf >&2 '\n'
        print_warning "SSH keys for '$profile' still exist:"
        print_info "  $key_file"
        print_info "  $key_file.pub"
        if confirm "Delete these SSH keys permanently?" "n"; then
            rm -f "$key_file" "$key_file.pub"
            print_success "SSH keys deleted."
        else
            print_info "Keys kept. You can manually delete them later."
        fi
    fi
}


# ------------------------------------------------------------------------------
# ------------------------------------------------------------------------------
# cmd_credential — Git Credential Helper Broker
# ------------------------------------------------------------------------------
cmd_credential() {
    local action="${1:-}"
    if [[ $# -ne 1 ]]; then
        print_error "Usage: gitsetu credential <get|store|erase>"
        return 1
    fi
    case "$action" in
        get|store|erase) ;;
        *)
            print_error "Unknown credential action: $action"
            return 1
            ;;
    esac

    local host="" protocol="" username="" password="" credential_path="" line
    local use_setup_fallback=1
    local seen_protocol=0 seen_host=0 seen_username=0 seen_password=0 seen_path=0
    local terminated=0 malformed=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ -n "$line" && "$line" == *$'\r'* ]]; then
            print_error "Malformed credential protocol: CR is not a valid line ending."
            return 1
        fi
        if [[ -z "$line" ]]; then
            if [[ "$terminated" -eq 1 ]]; then
                continue
            fi
            terminated=1
            continue
        fi
        if [[ "$terminated" -eq 1 ]]; then
            malformed=1
            break
        fi
        case "$line" in
            host=*)
                [[ "$seen_host" -eq 0 ]] || { malformed=1; break; }
                host="${line#*=}"; seen_host=1 ;;
            protocol=*)
                [[ "$seen_protocol" -eq 0 ]] || { malformed=1; break; }
                protocol="${line#*=}"; seen_protocol=1 ;;
            username=*)
                [[ "$seen_username" -eq 0 ]] || { malformed=1; break; }
                username="${line#*=}"; seen_username=1 ;;
            password=*)
                [[ "$seen_password" -eq 0 ]] || { malformed=1; break; }
                password="${line#*=}"; seen_password=1 ;;
            path=*)
                [[ "$seen_path" -eq 0 ]] || { malformed=1; break; }
                credential_path="${line#*=}"
                seen_path=1 ;;
            *)
                malformed=1; break ;;
        esac
    done
    if [[ "$malformed" -eq 1 || "$terminated" -eq 0 ]]; then
        print_error "Malformed credential protocol input."
        return 1
    fi
    # An explicit environment override is useful for wrappers and tests; normal
    # Git requests use the protocol's path= value as the exact tuple component.
    if [[ "${GITSETU_CREDENTIAL_PATH+x}" == "x" ]]; then
        credential_path="$GITSETU_CREDENTIAL_PATH"
        # Controlled wrappers selecting a path explicitly retain strict exact
        # tuple semantics and do not opt into the setup-PAT compatibility path.
        use_setup_fallback=0
    fi

    if [[ "$protocol" != "https" || -z "$host" ]]; then
        return 0
    fi

    local profile
    profile=$(cmd_prompt)
    if [[ -z "$profile" ]]; then
        return 0
    fi

    detect_os
    case "$action" in
        get)
            if [[ "$use_setup_fallback" -eq 1 ]]; then
                keychain_get_with_setup_fallback "$profile" "$host" "$credential_path"
            else
                keychain_get "$profile" "$host" "$credential_path"
            fi
            ;;
        store)
            if [[ -n "$username" && -n "$password" ]]; then
                keychain_store "$profile" "$host" "$username" "$password" "$credential_path"
            else
                return 1
            fi
            ;;
        erase)
            if [[ "$use_setup_fallback" -eq 1 ]]; then
                keychain_erase_with_setup_fallback "$profile" "$host" "$credential_path"
            else
                keychain_erase "$profile" "$host" "$credential_path"
            fi
            ;;
    esac
}

# ------------------------------------------------------------------------------
# cmd_doctor — Run diagnostics or repair configuration
# ------------------------------------------------------------------------------
cmd_doctor() {
    local repair=0
    local arg
    for arg in "$@"; do
        case "$arg" in
            --repair) repair=1 ;;
            --dry-run) GITSETU_DRY_RUN=1 ;;
            *)
                print_error "Unknown doctor option: $arg"
                printf >&2 'Usage: gitsetu doctor [--repair] [--dry-run]\n'
                return 1
                ;;
        esac
    done

    local registry_status=0
    load_profiles || registry_status=$?
    if [[ "$registry_status" -ne 0 ]]; then
        return "$registry_status"
    fi
    if [[ "$repair" -eq 1 ]]; then
        run_doctor_repair
    else
        run_doctor
    fi
}

# ------------------------------------------------------------------------------
# show_brief_usage — Print concise CLI usage
# ------------------------------------------------------------------------------
show_brief_usage() {
    printf >&2 '%bgitsetu%b v%s — One command. All identities. Every machine.\n\n' \
        "$BOLD" "$RESET" "$GITSETU_VERSION"
    printf >&2 'Usage: gitsetu setup [--auto] [--dry-run]    Start the setup wizard\n'
    printf >&2 '       gitsetu status               Show current identity\n'
    printf >&2 '       gitsetu profile <action>     Manage v2 profiles\n'
    printf >&2 '       gitsetu credential <action>  Git credential helper protocol\n'
    printf >&2 '       gitsetu verify               Test SSH and git config\n'
    printf >&2 '       gitsetu doctor [--repair]    Diagnose or repair configuration\n'
    printf >&2 '       gitsetu prompt               Print active profile (for PS1)\n'
    printf >&2 '       gitsetu run <profile> -- <cmd>  Run as identity\n'
    printf >&2 '       gitsetu remove <profile>     Remove a specific profile\n'
    printf >&2 '       gitsetu backup [out_file]    Export encrypted state vault\n'
    printf >&2 '       gitsetu restore <in_file>    Import encrypted state vault\n'
    printf >&2 '       gitsetu teardown [--force]   Remove all configurations\n'
    printf >&2 '       gitsetu guard --install      Install commit guard hook\n'
    printf >&2 '       gitsetu --help                Full help\n\n'
}

# ------------------------------------------------------------------------------
# Main — Parse arguments and route to subcommand
# ------------------------------------------------------------------------------
main() {
    if [[ $# -eq 0 ]]; then
        if [[ ! -t 0 || ! -t 1 || -n "${CI:-}" ]]; then
            show_brief_usage
            return 0
        fi

        detect_os
        load_profiles || return 1
        if [[ -f "$GITSETU_PROFILES_CONF" && "$PROFILE_COUNT" -gt 0 ]]; then
            cmd_status
        else
            preset_guided_onboarding
        fi
        return $?
    fi

    local cmd="${1:-}"
    shift

    case "$cmd" in
        setup|init)
            local auto_mode=0
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --dry-run) GITSETU_DRY_RUN=1 ;;
                    --auto|-y|--yes) auto_mode=1 ;;
                    *)
                        print_error "Unknown setup option: $1"
                        printf >&2 'Usage: gitsetu setup [--auto] [--dry-run]\n'
                        return 1
                        ;;
                esac
                shift
            done
            cmd_setup "$auto_mode"
            ;;
        add)
            if [[ $# -ne 4 ]]; then
                print_error "Usage: gitsetu add <label> \"<name>\" <email> <dir>"
                return 1
            fi
            cmd_add "$@"
            ;;
        status)
            if [[ $# -ne 0 ]]; then
                print_error "Usage: gitsetu status"
                return 1
            fi
            cmd_status
            ;;
        verify)
            if [[ $# -ne 0 ]]; then
                print_error "Usage: gitsetu verify"
                return 1
            fi
            cmd_verify
            ;;
        run)
            cmd_run "$@"
            ;;
        remove)
            cmd_remove "$@"
            ;;
        backup)
            if [[ $# -gt 1 ]]; then
                print_error "Usage: gitsetu backup [out_file]"
                return 1
            fi
            cmd_backup "$@"
            ;;
        restore)
            if [[ $# -ne 1 ]]; then
                print_error "Usage: gitsetu restore <in_file>"
                return 1
            fi
            cmd_restore "$@"
            ;;
        profile)
            if [[ $# -lt 2 ]]; then
                print_error "Usage: gitsetu profile <add|edit|remove> <label> [flags...]"
                return 1
            fi
            case "$1" in
                add|edit|remove) ;;
                *)
                    print_error "Unknown profile action: $1"
                    return 1
                    ;;
            esac
            cmd_profile "$@"
            ;;
        credential)
            cmd_credential "$@"
            ;;
        teardown)
            local force=0 deep=0
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --dry-run) GITSETU_DRY_RUN=1 ;;
                    --force|-f) force=1 ;;
                    --deep) deep=1 ;;
                    *)
                        print_error "Unknown teardown option: $1"
                        printf >&2 'Usage: gitsetu teardown [--dry-run] [--force] [--deep]\n'
                        return 1
                        ;;
                esac
                shift
            done
            cmd_teardown "$force" "$deep"
            ;;
        guard)
            if [[ $# -ne 1 ]]; then
                print_error "Usage: gitsetu guard --install | --uninstall"
                return 1
            fi
            case "$1" in
                --install)
                    detect_os
                    install_guard
                    ;;
                --uninstall)
                    detect_os
                    uninstall_guard
                    ;;
                *)
                    print_error "Unknown guard option: $1"
                    return 1
                    ;;
            esac
            ;;
        doctor)
            cmd_doctor "$@"
            ;;
        update)
            if [[ $# -ne 1 || ( "$1" != "--development" && "$1" != "--dev" ) ]]; then
                print_error "Usage: gitsetu update --development"
                return 1
            fi
            cmd_update "$1"
            ;;
        --help|-h|help)
            if [[ $# -ne 0 ]]; then
                print_error "Usage: gitsetu --help"
                return 1
            fi
            show_help
            ;;
        --version|-v)
            if [[ $# -ne 0 ]]; then
                print_error "Usage: gitsetu --version"
                return 1
            fi
            show_version
            ;;
        *)
            print_error "Unknown command: $cmd"
            printf >&2 'Run "gitsetu --help" for usage.\n'
            return 1
            ;;
    esac
}

main "$@"
