                # shellcheck disable=SC2034
                PROFILE_DIRS[1]="$work_dir"
                # shellcheck disable=SC2034
                PROFILE_PROVIDERS[1]="github.com"
                # shellcheck disable=SC2034
                PROFILE_SIGNS[1]="0"
                # shellcheck disable=SC2034
                PROFILE_KEYS[1]="${work_key:-$HOME/.ssh/id_ed25519_work}"
                # shellcheck disable=SC2034
                PROFILE_USERS[1]=""
                # shellcheck disable=SC2034
                PROFILE_PATS[1]=""

                # Profile 2: personal
