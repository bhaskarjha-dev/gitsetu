    email=${ident##*<}
    email=${email%%>*}
    while [[ "$name" == " "* || "$name" == $'\t'* ]]; do name="${name# }"; name="${name#$'\t'}"; done
    while [[ "$name" == *" " || "$name" == *$'\t' ]]; do name="${name% }"; name="${name%$'\t'}"; done
