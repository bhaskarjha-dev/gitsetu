#!/usr/bin/env bash
# gitsetu — One command. All identities. Every machine.
#
# A zero-dependency CLI tool for automated Git multi-identity
# and SSH key setup. Clone, run, done.
#
# Usage: ./gitsetu setup [--dry-run]
#        ./gitsetu status
#        ./gitsetu verify
#        ./gitsetu guard --install | --uninstall
#        ./gitsetu --help | --version
#
# https://github.com/bhaskarjha-dev/gitsetu
# MIT License — Bhaskar Jha

# --- CRLF self-healing for VirtualBox shared folders & Windows clones ---
# vboxsf injects \r into all files. Pure Bash 3.2 inspection detects \r with zero forks.
_crlf_depth="${GITSETU_CRLF_DEPTH:-0}"

# 1. Hard recursion guard: prevent runaway infinite exec loops
if [[ "$_crlf_depth" -ge 2 ]]; then
    echo "Error: CRLF self-healing recursion limit reached (depth=$_crlf_depth)." >&2
    echo "Ensure temporary directories are not located on a CRLF-injecting shared mount." >&2
    exit 1
fi

# 2. Inspect script header for carriage return using pure Bash (zero external process forks)
_crlf_l1=""
_crlf_l2=""
{
    read -r _crlf_l1 || true
    read -r _crlf_l2 || true
} < "${BASH_SOURCE[0]:-$0}" 2>/dev/null || true

# 3. Loop detection on shared filesystems (vboxsf):
# If already re-executed once but temporary script still contains \r, filesystem is re-injecting \r.
if [[ "$_crlf_depth" -ge 1 ]] && { [[ "$_crlf_l1" == *$'\r'* ]] || [[ "$_crlf_l2" == *$'\r'* ]]; }; then
    echo "Error: CRLF normalization loop detected." >&2
    echo "The temporary execution script still contains carriage returns." >&2
    echo "This occurs when TMPDIR is located on a VirtualBox shared folder (vboxsf)." >&2
    echo "Please set TMPDIR to a native filesystem (e.g., export TMPDIR=/tmp) and re-run." >&2
    exit 1
fi

# 4. Normalize and re-exec if carriage return is detected
if [[ "${GITSETU_CRLF_CLEAN:-}" != "1" ]] && [[ "${1:-}" != "credential" ]] && [[ "${1:-}" != "prompt" ]] && { [[ "$_crlf_l1" == *$'\r'* ]] || [[ "$_crlf_l2" == *$'\r'* ]]; }; then
    # Multi-directory fallback for temp file creation
    _crlf_tmp=""
    for _cand in "${TMPDIR:-}" "${TEMP:-}" "${TMP:-}" "/tmp" "/var/tmp" "${XDG_RUNTIME_DIR:-}" "${HOME:-}/.cache" "${HOME:-}" "."; do
        [[ -n "$_cand" && -d "$_cand" && -w "$_cand" ]] || continue
        _crlf_tmp=$(umask 077 && mktemp "${_cand%/}/.gitsetu_crlf.XXXXXX" 2>/dev/null || true)
        if [[ -n "$_crlf_tmp" && -f "$_crlf_tmp" && -w "$_crlf_tmp" ]]; then
            break
        fi
        _crlf_tmp=""
    done

    if [[ -z "$_crlf_tmp" || ! -f "$_crlf_tmp" ]]; then
        echo "Error: Failed to create temporary file for CRLF normalization." >&2
        echo "Checked: \$TMPDIR, \$TEMP, \$TMP, /tmp, /var/tmp, \$HOME, and current directory." >&2
        echo "Please ensure at least one temporary directory is writable and not full." >&2
        exit 1
    fi

    # Stripping cascade: tr -> sed -> awk -> pure bash
    _strip_status=1
    if command -v tr >/dev/null 2>&1; then
        tr -d '\r' < "${BASH_SOURCE[0]:-$0}" > "$_crlf_tmp" && _strip_status=0
    elif command -v sed >/dev/null 2>&1; then
        sed -e 's/\r$//' < "${BASH_SOURCE[0]:-$0}" > "$_crlf_tmp" && _strip_status=0
    elif command -v awk >/dev/null 2>&1; then
        awk '{ sub(/\r$/, ""); print }' "${BASH_SOURCE[0]:-$0}" > "$_crlf_tmp" && _strip_status=0
    else
        # Pure bash fallback (zero dependencies)
        while IFS= read -r _s_line || [[ -n "$_s_line" ]]; do
            printf '%s\n' "${_s_line%$'\r'}"
        done < "${BASH_SOURCE[0]:-$0}" > "$_crlf_tmp" && _strip_status=0
    fi

    if [[ "$_strip_status" -ne 0 ]]; then
        rm -f "$_crlf_tmp" 2>/dev/null || true
        echo "Error: Failed to strip carriage returns from script." >&2
        exit 1
    fi

    chmod 700 "$_crlf_tmp" 2>/dev/null || chmod 600 "$_crlf_tmp" 2>/dev/null || true
    export GITSETU_CRLF_CLEAN=1
    export GITSETU_CRLF_DEPTH=$(( _crlf_depth + 1 ))
    export GITSETU_CRLF_TMP="$_crlf_tmp"

    # Make ORIG_SCRIPT absolute before exec
    _orig_src="${BASH_SOURCE[0]:-$0}"
    if [[ "$_orig_src" != /* ]] && [[ "$_orig_src" != [a-zA-Z]:/* ]] && [[ "$_orig_src" != [a-zA-Z]:\\* ]]; then
        _orig_src="$(pwd)/$_orig_src"
    fi
    export GITSETU_ORIG_SCRIPT="$_orig_src"

    trap 'rm -f "$_crlf_tmp" 2>/dev/null || true' EXIT INT TERM
    exec "${BASH:-bash}" "$_crlf_tmp" "$@"
    rm -f "$_crlf_tmp" 2>/dev/null || true
    exit 1
fi

set -euo pipefail

# Register early cleanup trap for CRLF temporary file in child process
if [[ -n "${GITSETU_CRLF_TMP:-}" ]]; then
    trap 'rm -f "$GITSETU_CRLF_TMP" 2>/dev/null || true' EXIT INT TERM
fi

# Global cleanup tracking arrays
GITSETU_CLEANUP_FILES=()
GITSETU_CLEANUP_DIRS=()

# ------------------------------------------------------------------------------
# Resolve script directory (handles symlinks, $0 fallback, vboxsf CRLF re-exec)
# ------------------------------------------------------------------------------
resolve_script_dir() {
    # When re-executed for CRLF cleaning, BASH_SOURCE is /dev/fd/N.
    # Use GITSETU_ORIG_SCRIPT (set before re-exec) to find the real script.
    # Strip \r because the env var was set from a CRLF-contaminated line.
    local source="${GITSETU_ORIG_SCRIPT:-${BASH_SOURCE[0]:-$0}}"
    source="${source//$'\r'/}"

    # If source is empty or just a basename, try $0
    if [[ -z "$source" ]] || [[ "$source" == "bash" ]]; then
        source="$0"
    fi

    # If still relative, make it absolute (handles Unix / and Windows C:/ or C:\)
    if [[ "$source" != /* ]] && [[ "$source" != [a-zA-Z]:/* ]] && [[ "$source" != [a-zA-Z]:\\* ]]; then
        source="$(pwd)/$source"
    fi

    # Resolve symlinks
    while [[ -L "$source" ]]; do
        local link_dir
        link_dir=$(cd -P "$(dirname "$source")" 2>/dev/null && pwd)
        source=$(readlink "$source")
        if [[ "$source" != /* ]]; then
            source="$link_dir/$source"
        fi
    done

    local dir
    dir=$(cd -P "$(dirname "$source")" 2>/dev/null && pwd)
    if [[ ! -f "$dir/lib/core.sh" ]]; then
        if [[ -n "${GITSETU_DIR:-}" && -f "${GITSETU_DIR}/lib/core.sh" ]]; then
            dir="$GITSETU_DIR"
        elif [[ -f "$(pwd)/lib/core.sh" ]]; then
            dir="$(pwd)"
        elif [[ -f "$HOME/.local/share/gitsetu/lib/core.sh" ]]; then
            dir="$HOME/.local/share/gitsetu"
        fi
    fi
    printf '%s' "$dir"
}

GITSETU_SCRIPT_DIR="$(resolve_script_dir)"
GITSETU_SCRIPT_DIR="${GITSETU_SCRIPT_DIR//$'\r'/}"

# ------------------------------------------------------------------------------
# cmd_prompt — Zero-latency profile detection for PS1 integration
# ------------------------------------------------------------------------------
cmd_prompt() {
    if [[ ! -f "$GITSETU_PROFILES_CONF" ]]; then
        return 0
    fi

    # Normalize PWD like we do for dirs
    local current_pwd="${PWD%/}"
    if [[ "${OSTYPE:-}" == "msys"* ]] || [[ "${OSTYPE:-}" == "mingw"* ]] || [[ "${OSTYPE:-}" == "cygwin"* ]]; then
        current_pwd=$(pwd -W 2>/dev/null || echo "$current_pwd")
    fi
    current_pwd="${current_pwd//\\//}"
    if [[ "$current_pwd" =~ ^/([a-zA-Z])/(.*) ]]; then
        local drive="${BASH_REMATCH[1]}"
        local rest="${BASH_REMATCH[2]}"
        drive=$(printf '%s' "$drive" | tr '[:lower:]' '[:upper:]')
        current_pwd="${drive}:/${rest}"
    elif [[ "$current_pwd" =~ ^([a-zA-Z]):/(.*) ]]; then
        local drive="${BASH_REMATCH[1]}"
        local rest="${BASH_REMATCH[2]}"
        drive=$(printf '%s' "$drive" | tr '[:lower:]' '[:upper:]')
        current_pwd="${drive}:/${rest}"
    fi
    
    local is_ci=0
    case "${GITSETU_OS:-${OSTYPE:-}}" in
        gitbash|macos|msys*|mingw*|cygwin*|darwin*) is_ci=1 ;;
        *)
            local u
            u=$(uname -s 2>/dev/null || true)
            case "$u" in
                MSYS*|MINGW*|CYGWIN*|Darwin*) is_ci=1 ;;
            esac
            ;;
    esac

    local matched_profile=""
    local max_len=0

    # Prefix match without subshells
    local f1 _f2 f3 f4 _f5 _f6 _f7 _f8 _f9
    while IFS=: read -r f1 _f2 f3 f4 _f5 _f6 _f7 _f8 _f9 || [[ -n "$f1" ]]; do
        [[ "$f1" == "#"* ]] && continue
        [[ -z "$f1" ]] && continue

        local label="$f1"
        local dir="$f3"
        if [[ "${#f3}" -eq 1 ]] && [[ "$f4" == /* ]]; then
            dir="${f3}:${f4}"
        fi

        [[ -z "$dir" ]] && continue

        dir="${dir//\\//}"
        if [[ "$dir" =~ ^/([a-zA-Z])/(.*) ]]; then
            local d_drive="${BASH_REMATCH[1]}"
            local d_rest="${BASH_REMATCH[2]}"
            d_drive=$(printf '%s' "$d_drive" | tr '[:lower:]' '[:upper:]')
            dir="${d_drive}:/${d_rest}"
        elif [[ "$dir" =~ ^([a-zA-Z]):/(.*) ]]; then
            local d_drive="${BASH_REMATCH[1]}"
            local d_rest="${BASH_REMATCH[2]}"
            d_drive=$(printf '%s' "$d_drive" | tr '[:lower:]' '[:upper:]')
            dir="${d_drive}:/${d_rest}"
        fi

        local check_pwd="$current_pwd"
        local check_dir="$dir"
        if [[ "$is_ci" -eq 1 ]]; then
            check_pwd=$(printf '%s' "$check_pwd" | tr '[:upper:]' '[:lower:]')
            check_dir=$(printf '%s' "$check_dir" | tr '[:upper:]' '[:lower:]')
        fi
        
        # Check if PWD starts with the profile dir
        if [[ "$check_pwd/" == "$check_dir/"* ]] || [[ "$check_pwd" == "$check_dir" ]]; then
            # Longest match wins
            local dir_len=${#dir}
            if [[ "$dir_len" -gt "$max_len" ]]; then
                max_len=$dir_len
                matched_profile="$label"
            fi
        fi
    done < "$GITSETU_PROFILES_CONF"

    if [[ -n "$matched_profile" ]]; then
        echo "$matched_profile"
    fi
}

# Fast-path for prompt to avoid 14 subshell forks (95ms latency penalty)
if [[ "${1:-}" == "prompt" ]]; then
    if [[ -z "${GITSETU_PROFILES_CONF:-}" ]]; then
        GITSETU_PROFILES_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/gitsetu/profiles.conf"
    fi
    shift
    cmd_prompt "$@"
    exit $?
fi

# ------------------------------------------------------------------------------
# Source all library modules
# Strip \r from sourced files for vboxsf compatibility.
# Uses temp file + source instead of eval "$(tr ...)" because on bash 3.2
# (macOS default), command substitution subshells inherit and can consume
# stdin from pipes, breaking commands like "credential" that read stdin.
# ------------------------------------------------------------------------------
gitsetu_source() {
    local target="$1"
    if [[ ! -f "$target" ]]; then
        echo "Error: Required library module not found: $target" >&2
        return 1
    fi

    # Fast path: Pure Bash header inspection (zero subprocess forks)
    local _chk_line=""
    read -r _chk_line < "$target" 2>/dev/null || true
    if [[ "$_chk_line" != *$'\r'* ]]; then
        # shellcheck disable=SC1090
        source "$target"
        return $?
    fi

    # Slow path: CRLF-contaminated mount (vboxsf). Create mode 0600 temp file with directory fallback
    local _src_tmp="" _scand
    for _scand in "${TMPDIR:-}" "${TEMP:-}" "${TMP:-}" "/tmp" "/var/tmp" "${XDG_RUNTIME_DIR:-}" "${HOME:-}/.cache" "${HOME:-}" "."; do
        [[ -n "$_scand" && -d "$_scand" && -w "$_scand" ]] || continue
        _src_tmp=$(umask 077 && mktemp "${_scand%/}/.gitsetu_src.XXXXXX" 2>/dev/null || true)
        if [[ -n "$_src_tmp" && -f "$_src_tmp" && -w "$_src_tmp" ]]; then
            break
        fi
        _src_tmp=""
    done

    if [[ -z "$_src_tmp" || ! -f "$_src_tmp" ]]; then
        echo "Error: Failed to create temp file to source $target" >&2
        return 1
    fi

    GITSETU_CLEANUP_FILES+=("$_src_tmp")
    local _s_ok=0
    if command -v tr >/dev/null 2>&1; then
        tr -d '\r' < "$target" > "$_src_tmp" && _s_ok=1
    elif command -v sed >/dev/null 2>&1; then
        sed -e 's/\r$//' < "$target" > "$_src_tmp" && _s_ok=1
    elif command -v awk >/dev/null 2>&1; then
        awk '{ sub(/\r$/, ""); print }' "$target" > "$_src_tmp" && _s_ok=1
    else
        while IFS= read -r _l || [[ -n "$_l" ]]; do
            printf '%s\n' "${_l%$'\r'}"
        done < "$target" > "$_src_tmp" && _s_ok=1
    fi

    if [[ "$_s_ok" -ne 1 ]]; then
        rm -f "$_src_tmp" 2>/dev/null || true
        echo "Error: Failed to strip carriage returns from $target" >&2
        return 1
    fi

    # shellcheck disable=SC1090
    source "$_src_tmp"
    local _src_res=$?
    rm -f "$_src_tmp" 2>/dev/null || true
    return "$_src_res"
}
gitsetu_source "$GITSETU_SCRIPT_DIR/lib/core.sh"
gitsetu_source "$GITSETU_SCRIPT_DIR/lib/platform.sh"
gitsetu_source "$GITSETU_SCRIPT_DIR/lib/ui.sh"
gitsetu_source "$GITSETU_SCRIPT_DIR/lib/validate.sh"
gitsetu_source "$GITSETU_SCRIPT_DIR/lib/backup.sh"
gitsetu_source "$GITSETU_SCRIPT_DIR/lib/ssh.sh"
gitsetu_source "$GITSETU_SCRIPT_DIR/lib/gitconfig.sh"
gitsetu_source "$GITSETU_SCRIPT_DIR/lib/guard.sh"
gitsetu_source "$GITSETU_SCRIPT_DIR/lib/doctor.sh"
gitsetu_source "$GITSETU_SCRIPT_DIR/lib/verify.sh"
gitsetu_source "$GITSETU_SCRIPT_DIR/lib/teardown.sh"
gitsetu_source "$GITSETU_SCRIPT_DIR/lib/discovery.sh"
gitsetu_source "$GITSETU_SCRIPT_DIR/lib/setup.sh"
gitsetu_source "$GITSETU_SCRIPT_DIR/lib/keychain.sh"

# ------------------------------------------------------------------------------
# Unified Global Cleanup Architecture
# ------------------------------------------------------------------------------

gitsetu_global_cleanup() {
    # Restore terminal cursor visibility and echo if interrupted
    printf '\033[?25h' >&2 2>/dev/null || true
    stty echo 2>/dev/null || true
    # Clean up CRLF self-healing temp file if any
    if [[ -n "${GITSETU_CRLF_TMP:-}" ]] && [[ -f "$GITSETU_CRLF_TMP" ]]; then
        rm -f "$GITSETU_CRLF_TMP" 2>/dev/null || true
    fi
    local f d
    for f in ${GITSETU_CLEANUP_FILES[@]+"${GITSETU_CLEANUP_FILES[@]}"}; do
        rm -f "$f" 2>/dev/null || true
    done
    if type release_lock >/dev/null 2>&1; then
        GITSETU_LOCK_DEPTH=1
        release_lock 2>/dev/null || true
    fi
    for d in ${GITSETU_CLEANUP_DIRS[@]+"${GITSETU_CLEANUP_DIRS[@]}"}; do
        if [[ "$d" == *.lock ]]; then
            if [[ -f "$d/pid" ]]; then
                local lock_owner
                lock_owner=$(cat "$d/pid" 2>/dev/null || echo "")
                if [[ "$lock_owner" != "$$" ]]; then
                    continue # We do not own this lock. Do not delete it.
                fi
                rm -f "$d/pid" "$d/timestamp" 2>/dev/null || true
            else
                continue # Lock has no pid file; we do not own it. Do not delete it.
            fi
        fi
        rmdir "$d" 2>/dev/null || true
    done
}

cleanup() {
    printf '\033[?25h' >&2 2>/dev/null || true
    stty echo 2>/dev/null || true  # Restore terminal echo if interrupted during password entry
    printf >&2 '\n'
    print_warning "Interrupted. No changes were made (or partial changes were backed up)."
    gitsetu_global_cleanup
    exit 130
}
trap gitsetu_global_cleanup EXIT
trap cleanup SIGINT SIGTERM

# ------------------------------------------------------------------------------
# Usage / Help text
# ------------------------------------------------------------------------------
show_help() {
    cat >&2 <<EOF
${BOLD}gitsetu${RESET} v${GITSETU_VERSION} — One command. All identities. Every machine.

${BOLD}USAGE${RESET}
    gitsetu setup [--auto] [--dry-run]  Interactive wizard or zero-prompt discovery
    gitsetu init [--auto] [--dry-run]   Alias for setup
    gitsetu add <label> <name> <email> <dir>
                                     Add a profile (non-interactive)
    gitsetu remove <label>           Remove a profile
    gitsetu status                   Show current identity configuration
    gitsetu verify                   Test SSH keys and git config
    gitsetu doctor                   Run diagnostic checks
    gitsetu update                   Update gitsetu to the latest version
    gitsetu prompt                   Print active profile for \$PS1
    gitsetu backup [out_file]        Export encrypted identity state
    gitsetu restore <in_file>        Import encrypted identity state
    gitsetu run <profile> -- <cmd>   Run command as specific identity
    gitsetu teardown [--force] [--deep]  Remove all configurations
                                     --deep: Recursively strip local repository overrides
                                     --force: Bypass confirmation prompt
    gitsetu guard --install          Install pre-commit identity guard hook
    gitsetu guard --uninstall        Remove the guard hook
    gitsetu --help, -h               Show this help
    gitsetu --version, -v            Show version

${BOLD}EXAMPLES${RESET}
    ${DIM}# Instant zero-prompt onboarding:${RESET}
    gitsetu setup --auto

    ${DIM}# First-time interactive setup:${RESET}
    gitsetu setup

    ${DIM}# Add a profile non-interactively:${RESET}
    gitsetu add work "Your Name" work@company.com ~/work

    ${DIM}# Check current identity:${RESET}
    gitsetu status

    ${DIM}# Run git as a specific profile:${RESET}
    gitsetu run work -- git commit -m "fix"

    ${DIM}# Install commit safety net:${RESET}
    gitsetu guard --install

${BOLD}MORE INFO${RESET}
    https://github.com/bhaskarjha-dev/gitsetu
EOF
}

show_version() {
    printf 'gitsetu v%s\n' "$GITSETU_VERSION"
}

# ------------------------------------------------------------------------------
# cmd_status — Show current identity configuration
# ------------------------------------------------------------------------------
cmd_status() {
    detect_os

    print_header

    # Current directory info
    local cwd
    cwd=$(pwd)
    print_section "Current Directory"
    printf >&2 '  %s\n\n' "$cwd"

    # Current git identity
    local current_name current_email
    current_name=$(git config user.name 2>/dev/null || echo "(not set)")
    current_email=$(git config user.email 2>/dev/null || echo "(not set)")

    printf >&2 '  %b┌─ Active Identity ─────────────────────────────┐%b\n' "$BOLD" "$RESET"
    printf >&2 '  %b│%b  Name:  %b%s%b\n' "$DIM" "$RESET" "$CYAN" "${current_name}" "$RESET"
    printf >&2 '  %b│%b  Email: %b%s%b\n' "$DIM" "$RESET" "$CYAN" "${current_email}" "$RESET"
    
    # Check if inside a git repo
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        local ssh_cmd
        ssh_cmd=$(git config core.sshCommand 2>/dev/null || echo "(default)")
        printf >&2 '  %b│%b  SSH:   %b%s%b\n' "$DIM" "$RESET" "$GREEN" "${ssh_cmd}" "$RESET"
        
        # Check for Pre-Commit Guard Subversion
        local local_hooks
        local_hooks=$(git config --local core.hooksPath 2>/dev/null || true)
        if [[ -n "$local_hooks" ]]; then
            printf >&2 '  %b│%b\n' "$DIM" "$RESET"
            printf >&2 '  %b│%b  %b[!] SECURITY WARNING:%b\n' "$DIM" "$RESET" "$RED" "$RESET"
            printf >&2 '  %b│%b  This repository locally overrides core.hooksPath (%s).\n' "$DIM" "$RESET" "$local_hooks"
            printf >&2 '  %b│%b  The global GitSetu identity guard is completely bypassed!\n' "$DIM" "$RESET"
        fi
    fi
    printf >&2 '  %b└───────────────────────────────────────────────┘%b\n\n' "$DIM" "$RESET"

    # Show profile registry if it exists
    if [[ -f "$GITSETU_PROFILES_CONF" ]]; then
        print_section "Configured Profiles"

        # shellcheck disable=SC2034  # sign_commits parsed for field alignment
        local raw_line
        while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
            [[ "$raw_line" == "#"* ]] && continue
            [[ -z "$raw_line" ]] && continue
            local clean_line
            clean_line=$(printf '%s' "$raw_line" | sed -E 's/:([a-zA-Z]):/:\1#DRIVE#/g')
            local label email dir provider sign_commits key_path _unused
            IFS=: read -r label email dir provider sign_commits key_path _unused <<< "$clean_line"
            dir="${dir//#DRIVE#/:}"
            key_path="${key_path//#DRIVE#/:}"
            
            local dir_disp="${dir:-[Manual Mode]}"
            local prov_disp="${provider:-github.com}"
            
            # Load email from profile gitconfig (registry leaves email column empty)
            local profile_email
            profile_email=$(git config -f "$GITSETU_PROFILES_DIR/${label}.gitconfig" user.email 2>/dev/null || true)
            if [[ -z "$profile_email" ]] && [[ -n "$email" ]]; then
                profile_email="$email"  # Legacy fallback
            fi
            
            # Check if this profile matches current identity
            local is_active="  "
            if [[ -n "$profile_email" ]] && [[ "$profile_email" == "$current_email" ]]; then
                is_active="${GREEN}${SYM_CHECK} ${RESET}"
            fi
            
            printf >&2 '  %s%b%s%b\n' "$is_active" "$BOLD" "$label" "$RESET"
            printf >&2 '    %b├─%b %-9s %s\n' "$DIM" "$RESET" "Email:" "$profile_email"
            printf >&2 '    %b├─%b %-9s %s\n' "$DIM" "$RESET" "Provider:" "$prov_disp"
            printf >&2 '    %b└─%b %-9s %s\n\n' "$DIM" "$RESET" "Path:" "$dir_disp"
        done < "$GITSETU_PROFILES_CONF"
    else
        print_info "No profiles configured. Run 'gitsetu setup' to get started."
    fi

    # Platform info
    print_section "Environment"
    printf >&2 '  OS:       %s\n' "$GITSETU_OS"
    printf >&2 '  Bash:     %s\n' "${BASH_VERSION:-unknown}"
    printf >&2 '  Git:      %s\n' "$(git --version 2>/dev/null | head -n1)"
    printf >&2 '  Config:   %s\n' "$GITSETU_CONFIG_DIR"
    printf >&2 '\n'
}

# ------------------------------------------------------------------------------
# cmd_update — Safely update gitsetu to the latest version
# ------------------------------------------------------------------------------
cmd_update() {
    detect_os
    print_header

    # Ensure we are in a git-based installation
    if [[ ! -d "$GITSETU_DIR/.git" ]]; then
        print_error "GitSetu was not installed via Git. Cannot auto-update."
        print_info "If you installed via a raw script, please re-install using the official installer:"
        print_info "  curl -sL https://raw.githubusercontent.com/bhaskarjha-dev/gitsetu/main/install.sh | bash"
        return 1
    fi

    print_step "Checking for updates..."
    
    cd "$GITSETU_DIR" || return 1

    if ! git fetch --quiet origin 2>/dev/null; then
        print_error "Failed to reach GitHub. Check your network connection."
        return 1
    fi

    local current_hash
    local remote_hash
    current_hash=$(git rev-parse HEAD 2>/dev/null || echo "1")
    remote_hash=$(git rev-parse origin/main 2>/dev/null || echo "2")

    if [[ "$current_hash" == "$remote_hash" ]]; then
        print_success "GitSetu is already up-to-date (v${GITSETU_VERSION})"
        return 0
    fi

    print_info "Update found. Applying latest patches..."

    if ! git reset --quiet --hard origin/main 2>/dev/null; then
        print_error "Failed to apply update."
        return 1
    fi

    # Parse the new version from the freshly updated core.sh
    local new_version="Unknown"
    if [[ -f "$GITSETU_DIR/lib/core.sh" ]]; then
        new_version=$(grep "GITSETU_VERSION=" "$GITSETU_DIR/lib/core.sh" | head -n1 | cut -d'"' -f2 || echo "Unknown")
    fi

    if [[ "$GITSETU_VERSION" == "$new_version" ]]; then
        print_success "GitSetu successfully updated (v${new_version})"
    else
        print_success "GitSetu successfully updated from v${GITSETU_VERSION} to v${new_version}"
    fi
}

# ------------------------------------------------------------------------------
# cmd_verify — Run all verification checks
# ------------------------------------------------------------------------------
cmd_verify() {
    detect_os
    print_header

    # Load profiles from registry
    if [[ ! -f "$GITSETU_PROFILES_CONF" ]]; then
        print_error "No profiles configured. Run 'gitsetu setup' first."
        return 1
    fi

    # Read profiles from registry
    load_profiles

    if [[ "$PROFILE_COUNT" -eq 0 ]]; then
        print_error "No profiles found in registry. Run 'gitsetu setup' first."
        return 1
    fi

    verify_all
}

# ------------------------------------------------------------------------------
# cmd_teardown — Remove all gitsetu configurations
# ------------------------------------------------------------------------------
cmd_teardown() {
    detect_os
    print_header

    if [[ "$GITSETU_DRY_RUN" -eq 1 ]]; then
        print_info "DRY RUN MODE — no files will be written/deleted"
        printf >&2 '\n'
    fi

    local force="${1:-0}"
    local deep="${2:-0}"

    if [[ "$force" -eq 0 ]] && [[ "$GITSETU_DRY_RUN" -eq 0 ]]; then
        print_warning "This will remove all GitSetu configurations:"
        printf >&2 "  - Remove managed blocks from ~/.gitconfig\n"
        printf >&2 "  - Remove Include directive from ~/.ssh/config\n"
        printf >&2 "  - Uninstall the commit guard hook\n"
        printf >&2 "  - Delete the ~/.config/gitsetu directory\n"
        if [[ "$deep" -eq 1 ]]; then
            printf >&2 "  - STRIP local identity overrides from all mapped repositories\n"
        fi
        printf >&2 "\n"
        if ! confirm "Are you sure you want to proceed?" "n"; then
            print_info "Teardown cancelled."
            return 0
        fi
    fi

    acquire_lock || return 1
    teardown_all "$deep"
    release_lock
}

# ------------------------------------------------------------------------------
# cmd_setup — Interactive Blueprint Dashboard / Headless setup
# ------------------------------------------------------------------------------
cmd_setup() {
    local auto_mode="${1:-0}"
    detect_os
    print_header

    if [[ "$GITSETU_DRY_RUN" -eq 1 ]]; then
        print_info "DRY RUN MODE — no files will be written"
        printf >&2 '\n'
    fi

    # --- Preflight ---
    print_section "Preflight Checks"
    printf >&2 '  OS detected: %b%s%b\n' "$BOLD" "$GITSETU_OS" "$RESET"

    if ! check_prerequisites; then
        return 1
    fi
    print_success "All prerequisites met"

    # Check for shared folder
    if is_shared_mount "$HOME" 2>/dev/null; then
        print_warning "Home directory appears to be on a shared folder."
        print_info "SSH keys will be stored on the native filesystem at ~/.ssh"
    fi

    # Fast-path for autonomous zero-prompt discovery mode
    if [[ "$auto_mode" -eq 1 ]]; then
        export GITSETU_AUTO_MODE=1
        acquire_lock || return 1
        auto_setup_runner
        local auto_res=$?
        release_lock
        return "$auto_res"
    fi
    
    # Check if TTY
    if [[ ! -t 1 ]]; then
        print_error "Interactive setup requires an interactive terminal (TTY)."
        print_error "For automated non-interactive setup, run: gitsetu setup --auto"
        print_error "For headless profile scripting, use: gitsetu profile add <label> --email=..."
        return 1
    fi

    # Launch the interactive menu
    interactive_setup_wizard
}

# ------------------------------------------------------------------------------
# cmd_run — Execute a command under a specific profile identity
# ------------------------------------------------------------------------------
cmd_run() {
    detect_os
    local profile="$1"
    shift
    profile=$(to_lower "$profile")
    
    if [[ -z "$profile" ]]; then
        print_error "Usage: gitsetu run <profile> -- <command>"
        return 1
    fi
    
    if [[ "$1" == "--" ]]; then shift; fi
    
    if [[ $# -eq 0 ]]; then
        print_error "No command provided. Usage: gitsetu run <profile> -- <command>"
        return 1
    fi
    
    # Check if profile exists
    if [[ ! -f "$GITSETU_PROFILES_CONF" ]]; then
        print_error "No profiles configured. Run 'gitsetu setup' first."
        return 1
    fi

    local found=0
    local found_key_path=""
    # shellcheck disable=SC2034  # sign_commits parsed for field alignment
    local raw_line
    while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
        [[ "$raw_line" == "#"* ]] && continue
        [[ -z "$raw_line" ]] && continue
        local clean_line
        clean_line=$(printf '%s' "$raw_line" | sed -E 's/:([a-zA-Z]):/:\1#DRIVE#/g')
        local label email dir provider sign_commits key_path _unused
        IFS=: read -r label email dir provider sign_commits key_path _unused <<< "$clean_line"
        key_path="${key_path//#DRIVE#/:}"

        if [[ "$label" == "$profile" ]]; then
            found=1
            found_key_path="${key_path:-$HOME/.ssh/id_ed25519_${label}}"
            break
        fi
    done < "$GITSETU_PROFILES_CONF"
    
    if [[ "$found" -eq 0 ]]; then
        print_error "Profile '$profile' not found in registry."
        return 1
    fi
    
    local name email
    local config_file="$GITSETU_PROFILES_DIR/${profile}.gitconfig"
    
    if [[ ! -f "$config_file" ]]; then
        # Global profile (stored in ~/.gitconfig)
        name=$(git config --global user.name 2>/dev/null || echo "")
        email=$(git config --global user.email 2>/dev/null || echo "")
    else
        name=$(git config -f "$config_file" user.name 2>/dev/null || echo "")
        email=$(git config -f "$config_file" user.email 2>/dev/null || echo "")
    fi
    
    export GIT_AUTHOR_NAME="$name"
    export GIT_AUTHOR_EMAIL="$email"
    export GIT_COMMITTER_NAME="$name"
    export GIT_COMMITTER_EMAIL="$email"
    export GIT_SSH_COMMAND="ssh -i \"${found_key_path}\""
    
    # exec replaces this process — EXIT trap will never fire.
    # Flush any registered temp files before handoff.
    gitsetu_global_cleanup
    exec "$@"
}

# ------------------------------------------------------------------------------
# cmd_remove — Surgically remove a single profile
# ------------------------------------------------------------------------------
cmd_remove() {
    detect_os
    local profile="$1"
    profile=$(to_lower "$profile")
    
    if [[ -z "$profile" ]]; then
        print_error "Usage: gitsetu remove <profile>"
        return 1
    fi
    
    if [[ ! -f "$GITSETU_PROFILES_CONF" ]]; then
        print_error "No profiles configured."
        return 1
    fi
    
    # Check if profile exists
    local found=0
    local found_key_path=""
    # shellcheck disable=SC2034  # sign_commits parsed for field alignment; key_path is the target
    local raw_line
    while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
        [[ "$raw_line" == "#"* ]] && continue
        [[ -z "$raw_line" ]] && continue
        local clean_line
        clean_line=$(printf '%s' "$raw_line" | sed -E 's/:([a-zA-Z]):/:\1#DRIVE#/g')
        local label _email _dir _provider _sign_commits key_path _unused
        IFS=: read -r label _email _dir _provider _sign_commits key_path _unused <<< "$clean_line"
        key_path="${key_path//#DRIVE#/:}"

        if [[ "$label" == "$profile" ]]; then
            found=1
            found_key_path="${key_path:-$HOME/.ssh/id_ed25519_${label}}"
            break
        fi
    done < "$GITSETU_PROFILES_CONF"
    
    if [[ "$found" -eq 0 ]]; then
        print_error "Profile '$profile' not found."
        return 1
    fi

    if ! confirm "Are you sure you want to completely remove profile '$profile'?" "n"; then
        print_info "Cancelled."
        return 0
    fi
    
    acquire_lock || return 1

    print_step "Removing profile '$profile'..."
    
    # 1. Remove from profiles.conf using awk with secure temp file permissions
    local tmp_conf
    tmp_conf=$(umask 077 && mktemp "${GITSETU_PROFILES_CONF}.tmp.XXXXXX")
    GITSETU_CLEANUP_FILES+=("$tmp_conf")
    awk -F: -v prof="$profile" '$1 != prof {print}' "$GITSETU_PROFILES_CONF" > "$tmp_conf"
    chmod 600 "$tmp_conf" 2>/dev/null || true
    mv "$tmp_conf" "$GITSETU_PROFILES_CONF"
    chmod 600 "$GITSETU_PROFILES_CONF" 2>/dev/null || true
    
    # 2. Delete the profile gitconfig
    local config_file="$GITSETU_PROFILES_DIR/${profile}.gitconfig"
    if [[ -f "$config_file" ]]; then
        rm -f "$config_file"
    fi
    
    # 3. Reload in-memory arrays from the updated registry
    load_profiles
    
    # 4. Re-run block generators (idempotent, they will overwrite the global configs without the removed profile)
    if ! write_global_gitconfig; then
        print_warning "Failed to regenerate ~/.gitconfig. Run 'gitsetu setup' to repair."
    fi
    if ! write_ssh_config; then
        print_warning "Failed to regenerate ~/.ssh/config. Run 'gitsetu setup' to repair."
    fi
    
    release_lock

    print_success "Profile '$profile' successfully removed."
    
    # Ask about SSH keys
    local key_file="${found_key_path}"
    if [[ -f "$key_file" ]]; then
        printf >&2 '\n'
        print_warning "SSH keys for '$profile' still exist:"
        print_info "  $key_file"
        print_info "  $key_file.pub"
        if confirm "Delete these SSH keys permanently?" "n"; then
            rm -f "$key_file" "$key_file.pub"
            print_success "SSH keys deleted."
        else
            print_info "Keys kept. You can manually delete them later."
        fi
    fi
}


# ------------------------------------------------------------------------------
# ------------------------------------------------------------------------------
# cmd_credential — Git Credential Helper Broker
# ------------------------------------------------------------------------------
cmd_credential() {
    local action="${1:-}"
    if [[ -z "$action" ]]; then
        return 1
    fi

    # Read from stdin
    local host=""
    local protocol=""
    local username=""
    local password=""

    while read -r line; do
        [[ -z "$line" ]] && break
        case "$line" in
            host=*) host="${line#*=}" ;;
            protocol=*) protocol="${line#*=}" ;;
            username=*) username="${line#*=}" ;;
            password=*) password="${line#*=}" ;;
        esac
    done

    # We only care about https and host
    if [[ "$protocol" != "https" ]] || [[ -z "$host" ]]; then
        return 0
    fi

    # Identify profile context
    local profile
    profile=$(cmd_prompt)
    if [[ -z "$profile" ]]; then
        # Not in a profile directory, ignore
        return 0
    fi

    case "$action" in
        get)
            detect_os
            keychain_get "$profile" "$host"
            ;;
        store)
            if [[ -n "$username" ]] && [[ -n "$password" ]]; then
                detect_os
                keychain_store "$profile" "$host" "$username" "$password"
            fi
            ;;
        erase)
            detect_os
            keychain_erase "$profile" "$host"
            ;;
    esac
}

# ------------------------------------------------------------------------------
# cmd_doctor — Run diagnostics
# ------------------------------------------------------------------------------
cmd_doctor() {
    load_profiles
    run_doctor
}

# ------------------------------------------------------------------------------
# Main — Parse arguments and route to subcommand
# ------------------------------------------------------------------------------
main() {
    # No arguments → show brief usage
    if [[ $# -eq 0 ]]; then
        printf >&2 '%bgitsetu%b v%s — One command. All identities. Every machine.\n\n' \
            "$BOLD" "$RESET" "$GITSETU_VERSION"
        printf >&2 'Usage: gitsetu setup [--dry-run]    Start the setup wizard\n'
        printf >&2 '       gitsetu status               Show current identity\n'
        printf >&2 '       gitsetu verify               Test SSH and git config\n'
        printf >&2 '       gitsetu prompt               Print active profile (for PS1)\n'
        printf >&2 '       gitsetu run <profile> -- <cmd>  Run as identity\n'
        printf >&2 '       gitsetu remove <profile>     Remove a specific profile\n'
        printf >&2 '       gitsetu backup [out_file]    Export encrypted state vault\n'
        printf >&2 '       gitsetu restore <in_file>    Import encrypted state vault\n'
        printf >&2 '       gitsetu teardown [--force]   Remove all configurations\n'
        printf >&2 '       gitsetu guard --install      Install commit guard hook\n'
        printf >&2 '       gitsetu --help                Full help\n\n'
        return 0
    fi

    local cmd="$1"
    shift

    case "$cmd" in
        setup|init)
            # Parse setup flags
            local auto_mode=0
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --dry-run)
                        GITSETU_DRY_RUN=1
                        shift
                        ;;
                    --auto|-y|--yes)
                        auto_mode=1
                        shift
                        ;;
                    *)
                        print_error "Unknown flag: $1"
                        printf >&2 'Usage: gitsetu setup [--auto] [--dry-run]\n'
                        return 1
                        ;;
                esac
            done
            cmd_setup "$auto_mode"
            ;;
        add)
            cmd_add "$@"
            ;;
        status)
            cmd_status
            ;;
        verify)
            cmd_verify
            ;;
        run)
            if [[ $# -lt 1 ]]; then
                print_error "Usage: gitsetu run <profile> -- <command>"
                return 1
            fi
            cmd_run "$@"
            ;;
        remove)
            cmd_remove "${1:-}"
            ;;
        backup)
            cmd_backup "$@"
            ;;
        restore)
            cmd_restore "$@"
            ;;
        profile)
            cmd_profile "$@"
            ;;
        credential)
            cmd_credential "$@"
            ;;
        teardown)
            local force=0
            local deep=0
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --dry-run) GITSETU_DRY_RUN=1 ;;
                    --force|-f) force=1 ;;
                    --deep) deep=1 ;;
                    *)
                        print_error "Unknown flag: $1"
                        printf >&2 'Usage: gitsetu teardown [--dry-run] [--force] [--deep]\n'
                        return 1
                        ;;
                esac
                shift
            done
            cmd_teardown "$force" "$deep"
            ;;
        guard)
            if [[ $# -eq 0 ]]; then
                print_error "Usage: gitsetu guard --install | --uninstall"
                return 1
            fi
            case "$1" in
                --install)   detect_os; install_guard ;;
                --uninstall) detect_os; uninstall_guard ;;
                *)
                    print_error "Unknown flag: $1"
                    printf >&2 'Usage: gitsetu guard --install | --uninstall\n'
                    return 1
                    ;;
            esac
            ;;
        doctor)
            cmd_doctor "$@"
            ;;
        update)
            cmd_update
            ;;
        --help|-h|help)
            show_help
            ;;
        --version|-v)
            show_version
            ;;
        *)
            print_error "Unknown command: $cmd"
            printf >&2 'Run "gitsetu --help" for usage.\n'
            return 1
            ;;
    esac
}

main "$@"
