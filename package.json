{
  "name": "gitsetu",
  "version": "1.1.0",
  "private": true,
  "description": "Development build of the zero-trust multi-account Git identity orchestrator. v1.1.0 is not publicly released.",
  "main": "bin/gitsetu.js",
  "bin": {
    "gitsetu": "./bin/gitsetu.js",
    "git-setu": "./bin/gitsetu.js"
  },
  "files": [
    "bin/",
    "lib/",
    "gitsetu",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "metadata": "node packaging/release.js validate-source",
    "test": "bash tests/run_all.sh",
    "dist": "bash scripts/bundle.sh",
    "verify:bundle": "node packaging/release.js verify-bundle dist/gitsetu dist/gitsetu.manifest.json",
    "check": "npm run metadata && npm test && npm run dist && npm run verify:bundle"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhaskarjha-dev/gitsetu.git"
  },
  "keywords": [
    "git",
    "identity",
    "ssh",
    "multi-account",
    "gitconfig",
    "developer-tools",
    "productivity",
    "zero-trust"
  ],
  "author": "Bhaskar Jha <me@bhaskarjha.dev> (https://bhaskarjha.dev)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bhaskarjha-dev/gitsetu/issues"
  },
  "homepage": "https://gitsetu.bhaskarjha.dev",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@10.8.2",
  "gitsetuRelease": {
    "state": "development",
    "manifest": "packaging/release.json"
  }
}
