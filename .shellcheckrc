# ShellCheck configuration for gitsetu
# https://www.shellcheck.net/wiki/

# Target shell dialect
shell=bash

# Follow sourced files relative to project root
source-path=lib
source-path=tests

# SC1091: Not following sourced files (ShellCheck can't resolve dynamic paths)
# All test files source helpers.sh via $(dirname "${BASH_SOURCE[0]}")/helpers.sh
# which ShellCheck cannot follow statically.
disable=SC1091

# SC2034: Global configuration arrays (PROFILE_LABELS, PROFILE_DIRS, etc.)
# are defined/mocked across modular files and consumed by other sourced libraries.
disable=SC2034

# SC2088: GitSetu intentionally uses portable literal tilde ('~/.ssh/...', '~/.gitconfig')
# strings in generated OpenSSH and Git configs because Git and OpenSSH natively expand
# tildes at runtime.
disable=SC2088

# SC2119 / SC2120: Helper functions (such as acquire_lock/release_lock) accept optional
# arguments with defaults; callers do not need to pass arguments.
disable=SC2119
disable=SC2120

# SC2015: Note that A && B || C is not if-then-else. While all existing occurrences
# in core engines have been refactored to explicit if-then-else structures, disabling
# SC2015 prevents false-positive CI failures on idiomatic guarded fallbacks.
disable=SC2015

# SC2317: Test harnesses and trap handlers define mock overrides (e.g. ssh, git,
# tar, write_profile_gitconfig) and emergency cleanup handlers that are invoked
# indirectly by sourced engines or signal traps rather than direct static calls.
disable=SC2317
