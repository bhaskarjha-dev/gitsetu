#!/usr/bin/env bash
# gh-gitsetu — integrity-verifying GitHub CLI extension for GitSetu.
set -euo pipefail
umask 077

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"

error() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

load_release_config() {
    local config="" candidate key value
    for candidate in "$SCRIPT_DIR/release.env" "$SCRIPT_DIR/../release.env"; do
        if [[ -f "$candidate" && ! -L "$candidate" ]]; then
            config="$candidate"
            break
        fi
    done
    [[ -n "$config" ]] || error "GitSetu release metadata is missing from this extension."

    GITSETU_RELEASE_STATE=""
    GITSETU_RELEASE_VERSION=""
    GITSETU_RELEASE_TAG=""
    GITSETU_RELEASE_COMMIT=""
    GITSETU_ARTIFACT_URL=""
    GITSETU_ARTIFACT_SHA256=""
    GITSETU_ARTIFACT_SIZE=""
    GITSETU_SIGNATURE_URL=""
    GITSETU_SIGNATURE_BUNDLE_URL=""
    GITSETU_CERTIFICATE_IDENTITY=""
    GITSETU_CERTIFICATE_OIDC_ISSUER=""
    seen_keys="|"

    while IFS='=' read -r key value || [[ -n "$key" ]]; do
        [[ -z "$key" || "$key" == \#* ]] && continue
        case "$key" in
            GITSETU_RELEASE_STATE|GITSETU_RELEASE_VERSION|GITSETU_RELEASE_TAG|GITSETU_RELEASE_COMMIT|\
            GITSETU_ARTIFACT_URL|GITSETU_ARTIFACT_SHA256|GITSETU_ARTIFACT_SIZE|GITSETU_SIGNATURE_URL|\
            GITSETU_SIGNATURE_BUNDLE_URL|GITSETU_CERTIFICATE_IDENTITY|GITSETU_CERTIFICATE_OIDC_ISSUER|\
            GITSETU_WINDOWS_ZIP_URL|GITSETU_WINDOWS_ZIP_SHA256|GITSETU_WINDOWS_ZIP_SIZE|\
            GITSETU_WINDOWS_SIGNATURE_URL|GITSETU_WINDOWS_SIGNATURE_BUNDLE_URL) ;;
            *) error "Unexpected key in GitSetu release metadata: $key" ;;
        esac
        if [[ "$value" == *[[:space:]]* || "$value" == *\\* ]]; then
            error "Unsafe value for $key in GitSetu release metadata"
        fi
        case "$seen_keys" in
            *"|$key|"*) error "Duplicate key in GitSetu release metadata: $key" ;;
        esac
        seen_keys="${seen_keys}${key}|"
        case "$key" in
            GITSETU_RELEASE_STATE) GITSETU_RELEASE_STATE="$value" ;;
            GITSETU_RELEASE_VERSION) GITSETU_RELEASE_VERSION="$value" ;;
            GITSETU_RELEASE_TAG) GITSETU_RELEASE_TAG="$value" ;;
            GITSETU_RELEASE_COMMIT) GITSETU_RELEASE_COMMIT="$value" ;;
            GITSETU_ARTIFACT_URL) GITSETU_ARTIFACT_URL="$value" ;;
            GITSETU_ARTIFACT_SHA256) GITSETU_ARTIFACT_SHA256="$value" ;;
            GITSETU_ARTIFACT_SIZE) GITSETU_ARTIFACT_SIZE="$value" ;;
            GITSETU_SIGNATURE_URL) GITSETU_SIGNATURE_URL="$value" ;;
            GITSETU_SIGNATURE_BUNDLE_URL) GITSETU_SIGNATURE_BUNDLE_URL="$value" ;;
            GITSETU_CERTIFICATE_IDENTITY) GITSETU_CERTIFICATE_IDENTITY="$value" ;;
            GITSETU_CERTIFICATE_OIDC_ISSUER) GITSETU_CERTIFICATE_OIDC_ISSUER="$value" ;;
            GITSETU_WINDOWS_*) : ;;
        esac
    done < "$config"

    [[ "$GITSETU_RELEASE_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || error "Invalid GitSetu release version metadata"
    [[ -n "$GITSETU_CERTIFICATE_OIDC_ISSUER" ]] || error "GitSetu signature issuer metadata is missing"
}

load_release_config

# A source checkout is authoritative only when this extension is physically
# inside that checkout. Never delegate through an arbitrary PATH entry.
for local_core in "$SCRIPT_DIR/../../gitsetu" "$SCRIPT_DIR/gitsetu"; do
    if [[ -f "$local_core" && ! -L "$local_core" ]]; then
        exec "$local_core" "$@"
    fi
done

is_test_mode() {
    [[ "${GITSETU_TEST_MODE:-}" == "1" ]]
}

if [[ "$GITSETU_RELEASE_STATE" == "development" ]] && ! is_test_mode; then
    error "GitSetu v${GITSETU_RELEASE_VERSION} is in development and has no public extension artifact. Use a checkout or a verified release."
fi

if [[ "$GITSETU_RELEASE_STATE" != "released" ]] && ! is_test_mode; then
    error "Unsupported GitSetu release state: $GITSETU_RELEASE_STATE"
fi

if is_test_mode; then
    ARTIFACT_FILE="${GITSETU_TEST_ARTIFACT:-}"
    EXPECTED_SHA256="${GITSETU_TEST_ARTIFACT_SHA256:-}"
else
    [[ "$GITSETU_RELEASE_TAG" == "v${GITSETU_RELEASE_VERSION}" ]] || error "Release tag/version mismatch"
    [[ "$GITSETU_RELEASE_COMMIT" =~ ^[0-9a-f]{40}$ ]] || error "Release commit pin is missing or invalid"
    [[ "$GITSETU_ARTIFACT_URL" == "https://github.com/bhaskarjha-dev/gitsetu/releases/download/${GITSETU_RELEASE_TAG}/"* ]] || error "Artifact URL is not an immutable GitSetu release URL"
    [[ "$GITSETU_ARTIFACT_SHA256" =~ ^[0-9a-f]{64}$ ]] || error "A SHA-256 pin is required for the extension artifact"
    [[ "$GITSETU_ARTIFACT_SIZE" =~ ^[1-9][0-9]*$ ]] || error "An exact artifact byte size is required"
    [[ -n "$GITSETU_SIGNATURE_URL" && -n "$GITSETU_SIGNATURE_BUNDLE_URL" && -n "$GITSETU_CERTIFICATE_IDENTITY" ]] || error "Signature metadata is required"
    [[ "$GITSETU_CERTIFICATE_IDENTITY" == https://github.com/bhaskarjha-dev/gitsetu/* ]] || error "Signature identity is outside the GitSetu repository"
    [[ "$GITSETU_SIGNATURE_URL" == "${GITSETU_ARTIFACT_URL%/*}/"* && "$GITSETU_SIGNATURE_BUNDLE_URL" == "${GITSETU_ARTIFACT_URL%/*}/"* ]] || error "Signature URLs are not pinned beside the release artifact"
    ARTIFACT_FILE="$GITSETU_ARTIFACT_URL"
    EXPECTED_SHA256="$GITSETU_ARTIFACT_SHA256"
    EXPECTED_SIZE="$GITSETU_ARTIFACT_SIZE"
    ARTIFACT_URL="$GITSETU_ARTIFACT_URL"
    SIGNATURE_URL="$GITSETU_SIGNATURE_URL"
    SIGNATURE_BUNDLE_URL="$GITSETU_SIGNATURE_BUNDLE_URL"
fi

[[ -n "$ARTIFACT_FILE" && -n "$EXPECTED_SHA256" ]] || error "An artifact and SHA-256 are required"
[[ "$EXPECTED_SHA256" =~ ^[0-9a-f]{64}$ ]] || error "The expected SHA-256 is invalid"

find_hash_tool() {
    local candidate
    if is_test_mode && [[ -n "${GITSETU_TEST_HASH_TOOL:-}" ]]; then
        candidate="$GITSETU_TEST_HASH_TOOL"
        if [[ "$candidate" == /* && -x "$candidate" && ! -L "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    fi
    for candidate in /usr/bin/sha256sum /bin/sha256sum /usr/bin/shasum /bin/shasum /usr/local/bin/sha256sum; do
        if [[ -x "$candidate" && ! -L "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

HASH_TOOL="$(find_hash_tool)" || error "No trusted SHA-256 implementation was found; refusing to download or execute the extension artifact."

# shasum defaults to SHA-1; GNU sha256sum is already SHA-256 and
# rejects -a. Without this, macOS verifies a SHA-1 digest against
# a SHA-256 pin and every install fails closed.
case "$HASH_TOOL" in
    *shasum) HASH_TOOL_ARGS=(-a 256) ;;
    *) HASH_TOOL_ARGS=() ;;
esac

hash_file() {
    local file="$1" output
    output="$("$HASH_TOOL" "${HASH_TOOL_ARGS[@]+"${HASH_TOOL_ARGS[@]}"}" "$file" 2>/dev/null)" || return 1
    case "$HASH_TOOL" in
        *sha256sum) printf '%s\n' "${output%% *}" ;;
        *) printf '%s\n' "$(printf '%s\n' "$output" | awk '{print $1}')" ;;
    esac
}

verify_file() {
    local file="$1" expected="$2" actual
    [[ -f "$file" && ! -L "$file" ]] || return 1
    actual="$(hash_file "$file")" || return 1
    [[ "$actual" == "$expected" ]]
}

find_downloader() {
    local candidate
    if is_test_mode && [[ -n "${GITSETU_TEST_DOWNLOADER:-}" ]]; then
        candidate="$GITSETU_TEST_DOWNLOADER"
        if [[ "$candidate" == /* && -x "$candidate" && ! -L "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    fi
    for candidate in /usr/bin/curl /bin/curl /usr/local/bin/curl /usr/bin/wget /bin/wget; do
        if [[ -x "$candidate" && ! -L "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

download_artifact() {
    local url="$1" output="$2" downloader
    downloader="$(find_downloader)" || error "No trusted HTTPS downloader was found"
    case "$downloader" in
        *curl)
            "$downloader" --fail --silent --show-error --location --proto '=https' --tlsv1.2 --max-redirs 3 --output "$output" "$url"
            ;;
        *wget)
            "$downloader" --https-only --secure-protocol=TLSv1_2 --max-redirect=3 --output-document="$output" "$url"
            ;;
    esac
}

find_cosign() {
    local candidate
    for candidate in /usr/local/bin/cosign /usr/bin/cosign /bin/cosign; do
        if [[ -x "$candidate" && ! -L "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

CACHE_BASE="${XDG_CACHE_HOME:-$HOME/.cache}"
[[ "$CACHE_BASE" == /* ]] || error "XDG_CACHE_HOME must be an absolute path"
[[ -z "${HOME:-}" || "$HOME" == /* ]] || error "HOME must be an absolute path"
mkdir -p "$CACHE_BASE" || error "Could not create the cache base"
[[ -d "$CACHE_BASE" && ! -L "$CACHE_BASE" ]] || error "Cache base must be a real directory"
CACHE_DIR="$CACHE_BASE/gitsetu/extension-v${GITSETU_RELEASE_VERSION}"
mkdir -p "$CACHE_DIR" || error "Could not create the private extension cache"
chmod 700 "$CACHE_DIR" || error "Could not secure the extension cache"
[[ -d "$CACHE_DIR" && ! -L "$CACHE_DIR" ]] || error "Extension cache path is a symbolic link"
RUNNER="$CACHE_DIR/gitsetu"

if [[ -e "$RUNNER" || -L "$RUNNER" ]]; then
    [[ -f "$RUNNER" && ! -L "$RUNNER" ]] || error "Cached extension artifact is not a regular file"
    verify_file "$RUNNER" "$EXPECTED_SHA256" || error "Cached extension artifact failed SHA-256 verification; remove $CACHE_DIR and retry"
else
    TEMP_DIR="$(mktemp -d "$CACHE_DIR/.download.XXXXXX")" || error "Could not create a private download directory"
    TEMP_FILE="$TEMP_DIR/gitsetu"
    trap 'rm -rf -- "$TEMP_DIR"' EXIT HUP INT TERM

    if is_test_mode && [[ -f "$ARTIFACT_FILE" && ! -L "$ARTIFACT_FILE" ]]; then
        cp -- "$ARTIFACT_FILE" "$TEMP_FILE"
    else
        [[ -n "${ARTIFACT_URL:-}" ]] || error "No immutable release artifact URL is available"
        download_artifact "$ARTIFACT_URL" "$TEMP_FILE" || error "GitSetu extension artifact download failed"
    fi

    [[ -f "$TEMP_FILE" && ! -L "$TEMP_FILE" ]] || error "Downloaded extension artifact is not a regular file"
    verify_file "$TEMP_FILE" "$EXPECTED_SHA256" || error "GitSetu extension artifact failed SHA-256 verification"
    if [[ -n "${EXPECTED_SIZE:-}" ]]; then
        actual_size="$(wc -c < "$TEMP_FILE" | tr -d '[:space:]')"
        [[ "$actual_size" == "$EXPECTED_SIZE" ]] || error "GitSetu extension artifact size does not match release metadata"
    fi
    chmod 500 "$TEMP_FILE" || error "Could not make the verified artifact executable"
    mv -f -- "$TEMP_FILE" "$RUNNER" || error "Could not promote the verified extension artifact"
    rm -rf -- "$TEMP_DIR"
    trap - EXIT HUP INT TERM
fi

verify_file "$RUNNER" "$EXPECTED_SHA256" || error "Final extension cache verification failed"

if ! is_test_mode; then
    COSIGN_TOOL="$(find_cosign)" || error "A trusted cosign executable is required to verify the signed release artifact"
    SIGNATURE_FILE="$CACHE_DIR/gitsetu.sig"
    SIGNATURE_BUNDLE="$CACHE_DIR/gitsetu.sigstore.json"
    for signature_target in "$SIGNATURE_FILE" "$SIGNATURE_BUNDLE"; do
        if [[ -e "$signature_target" && (! -f "$signature_target" || -L "$signature_target") ]]; then
            error "Cached signature material is not a regular file"
        fi
    done
    if [[ ! -f "$SIGNATURE_FILE" || ! -f "$SIGNATURE_BUNDLE" ]]; then
        SIGNATURE_TEMP="$(mktemp -d "$CACHE_DIR/.signature.XXXXXX")" || error "Could not create a private signature directory"
        trap 'rm -rf -- "$SIGNATURE_TEMP"' EXIT HUP INT TERM
        download_artifact "$SIGNATURE_URL" "$SIGNATURE_TEMP/gitsetu.sig" || error "Release signature download failed"
        download_artifact "$SIGNATURE_BUNDLE_URL" "$SIGNATURE_TEMP/gitsetu.sigstore.json" || error "Release signature bundle download failed"
        [[ -f "$SIGNATURE_TEMP/gitsetu.sig" && ! -L "$SIGNATURE_TEMP/gitsetu.sig" ]] || error "Downloaded signature is invalid"
        [[ -f "$SIGNATURE_TEMP/gitsetu.sigstore.json" && ! -L "$SIGNATURE_TEMP/gitsetu.sigstore.json" ]] || error "Downloaded signature bundle is invalid"
        mv -f -- "$SIGNATURE_TEMP/gitsetu.sig" "$SIGNATURE_FILE"
        mv -f -- "$SIGNATURE_TEMP/gitsetu.sigstore.json" "$SIGNATURE_BUNDLE"
        rm -rf -- "$SIGNATURE_TEMP"
        trap - EXIT HUP INT TERM
    fi
    "$COSIGN_TOOL" verify-blob \
        --certificate-identity "$GITSETU_CERTIFICATE_IDENTITY" \
        --certificate-oidc-issuer "$GITSETU_CERTIFICATE_OIDC_ISSUER" \
        --signature "$SIGNATURE_FILE" \
        --bundle "$SIGNATURE_BUNDLE" \
        "$RUNNER" >/dev/null 2>&1 || error "GitSetu release signature verification failed"
fi

exec "$RUNNER" "$@"
