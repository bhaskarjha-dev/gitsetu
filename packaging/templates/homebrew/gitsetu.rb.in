require "shellwords"

class Gitsetu < Formula
  desc "Zero-trust multi-account Git identity orchestrator"
  homepage "https://gitsetu.bhaskarjha.dev"
  url "{{SOURCE_URL}}"
  sha256 "{{SOURCE_SHA256}}"
  license "MIT"
  version "{{VERSION}}"

  depends_on "bash"
  depends_on "git"
  depends_on "openssh"
  depends_on "openssl"

  def install
    libexec.install "lib"
    libexec.install "gitsetu"

    (bin/"gitsetu").write <<~EOS
      #!/usr/bin/env bash
      exec #{Shellwords.escape(libexec/"gitsetu")} "$@"
    EOS
    bin.install_symlink bin/"gitsetu" => "git-setu"
    bash_completion.install "lib/completion.sh" => "gitsetu"
  end

  test do
    assert_match "gitsetu v{{VERSION}}", shell_output("#{bin}/gitsetu --version")
    assert_match "gitsetu v{{VERSION}}", shell_output("#{bin}/git-setu --version")
  end
end
