# ============================================
# GitSetu .gitignore — Pre-Launch Production
# ============================================

# --- Security: SSH keys & secrets ---
# Never commit private keys, public keys, or encrypted vaults
id_rsa*
id_ed25519*
ed25519
ed25519.pub
*.pem
*.key
*.enc
!docs/guides/vault-backups.md
.tokens
gitsetu_vault_pre_restore_*.tar.gz.enc.password

# --- Node.js ---
node_modules/
npm-debug.log*
package-lock.json
*.tgz

# --- Backups & temporaries ---
*.bak
*.tmp
*.log
*.orig
*.rej

# --- OS files ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Temporary test directories ---
tmp/
test_tmp/
test_dir/

# --- Sandbox ---
sandbox/results/
sandbox/new_phases.sh
sandbox_results/
*.wsb

# --- Editors & IDEs ---
*.swp
*.swo
*~
.vscode/
.idea/
*.iml

# --- Distribution ---
dist/*.exe

# --- One-off & generated ---
commit_plan.sh

# --- Separate repos ---
gitsetu-web/

# --- Agentic development ---
.agents/
TEST_READY.md
